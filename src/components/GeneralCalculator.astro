        const phaseDesc=cycleDay<=periodLen?'Uterine lining shedding; lowest fertility':cycleDay<=7?'Endometrium rebuilding; low fertility':cycleDay<=12?'Cervical mucus increasing; fertility rising':cycleDay<=16?'Peak fertility; egg released':'Progesterone dominant; fertility declining';
        let calendarHTML='<div class="mt-4"><p class="text-xs font-semibold tracking-[.08em] text-[var(--muted)] mb-3">3-MONTH PROJECTION</p><div class="rounded-xl border overflow-hidden" style="border-color:var(--line)"><table class="w-full text-left text-sm"><thead class="bg-[var(--soft)]"><tr><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Month</th><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Period Start</th><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Fertile Window</th><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Ovulation</th></tr></thead><tbody>';
        for(let i=0;i<3;i++){
          const mPeriod=new Date(date);
          mPeriod.setDate(mPeriod.getDate()+cycleLen*i);
          const mOvulation=new Date(mPeriod);
          mOvulation.setDate(mOvulation.getDate()+cycleLen-14);
          const mFertileStart=new Date(mOvulation);
          mFertileStart.setDate(mFertileStart.getDate()-5);
          const mFertileEnd=new Date(mOvulation);
          mFertileEnd.setDate(mFertileEnd.getDate()+1);
          const isCurrent=i===0;
          calendarHTML+='<tr class="'+(isCurrent?'bg-[var(--color-primary)]/5 font-semibold':'')+' border-t" style="border-color:var(--line)"><td class="px-3 py-2 text-xs">'+(isCurrent?'> ':'')+(i===0?'Current':i===1?'Next':'+2 Months')+'</td><td class="px-3 py-2 text-xs">'+fmtShort(mPeriod)+'</td><td class="px-3 py-2 text-xs text-amber-600">'+fmtShort(mFertileStart)+'-'+fmtShort(mFertileEnd)+'</td><td class="px-3 py-2 text-xs text-emerald-600">'+fmtShort(mOvulation)+'</td></tr>';
        }
        calendarHTML+='</tbody></table></div></div>';
        output=card('OVULATION DATE',fmt(ovulation),'In '+daysTilOvulation+' days',true)
          +card('FERTILE WINDOW',fmtShort(fertileStart)+' - '+fmtShort(fertileEnd),'6 days; sperm survive up to 5 days')
          +card('BEST DAYS TO CONCEIVE',fmtShort(new Date(ovulation.getTime()-2*864e5))+' - '+fmtShort(ovulation),'3 days before and day of ovulation')
          +card('NEXT PERIOD',fmt(nextPeriod),'In '+daysTilPeriod+' days')
          +card('CURRENT PHASE',currentPhase,phaseDesc)
          +card('CYCLE DAY',cycleDay+' of '+cycleLen,'Day 1 = first day of last period')
          +card('CYCLE LENGTH',cycleLen+' days','28-30 days is typical')
          +card('PERIOD LENGTH',periodLen+' days','2-7 days is normal')
          +card('LUTEAL PHASE','14 days','Fixed in most women; varies 12-16 days')
          +calendarHTML;}
      if (kind === 'bsa') { const mosteller=Math.sqrt(n('weight')*n('height')/3600), dubois=.007184*n('weight')**.425*n('height')**.725; output=card('MOSTELLER BSA',`${number(mosteller,2)} m²`)+card('DU BOIS BSA',`${number(dubois,2)} m²`)+card('AVERAGE',`${number((mosteller+dubois)/2,2)} m²`); }
      if (kind === 'bac') { const alcohol=n('drinks')*14, ratio=s('sex')==='female'?.55:.68, bac=Math.max(0,alcohol/(n('weight')*1000*ratio)*100-.015*n('hours')); const usLimit=0.08, euLimit=0.05; const status=bac<euLimit?'Legal to drive (EU)':bac<usLimit?'Illegal in EU, legal in some US states':bac<0.2?'Driving prohibited':bac<0.3?'Severe impairment':'Life-threatening'; output=card('ESTIMATED BAC',`${number(bac,3)}%`,status)+card('STANDARD DRINKS',number(n('drinks'),0))+card('US LEGAL LIMIT','0.08%','0.08 BAC for drivers 21+')+card('EU LEGAL LIMIT','0.05%','Most European countries 0.05%')+card('SAFETY','Do not drive','BAC estimates are not measurements'); }
      if (kind === 'gfr') { const female=s('sex')==='female', k=female?.7:.9, a=female?-.241:-.302, scr=n('creatinine'), egfr=142*Math.min(scr/k,1)**a*Math.max(scr/k,1)**-1.2*.9938**n('age')*(female?1.012:1); const stage=egfr>=90?'G1 Normal':egfr>=60?'G2 Mild decrease':egfr>=45?'G3a Mild-moderate':egfr>=30?'G3b Moderate-severe':egfr>=15?'G4 Severe decrease':'G5 Kidney failure'; output=card('ESTIMATED GFR',`${number(egfr,0)} mL/min/1.73m²`,stage)+card('CKD STAGE',stage)+card('EQUATION','2021 CKD-EPI','Race-free creatinine equation')+card('IMPORTANT','Discuss clinically','One result cannot diagnose CKD'); }
      if (kind === 'pregnancy-weight') {
        const h=n('height')/100, bmi=n('preweight')/h**2, twins=s('twins')==='twins', week=n('week'), currentW=n('current'), preW=n('preweight');
        const bmiCat=bmi<18.5?'Underweight':bmi<25?'Normal weight':bmi<30?'Overweight':'Obese';
        const iomData={underweight:{singleton:[12.5,18],twins:[22.5,31.5]},normal:{singleton:[11.5,16],twins:[16.8,24.5]},overweight:{singleton:[7,11.5],twins:[14.1,22.7]},obese:{singleton:[5,9],twins:[11.3,19.1]}};
        const catKey=bmi<18.5?'underweight':bmi<25?'normal':bmi<30?'overweight':'obese';
        const range=iomData[catKey][twins?'twins':'singleton'];
        const minGain=range[0], maxGain=range[1], avgGain=(minGain+maxGain)/2;
        const gainSoFar=currentW-preW;
        const weeksRemaining23=Math.max(0,40-week);
        const totalMinLbs=minGain*2.20462, totalMaxLbs=maxGain*2.20462, gainLbs=gainSoFar*2.20462;
        const isUnderweight=gainSoFar<minGain*(Math.min(week,40)/40);
        const isOverweight=gainSoFar>maxGain*(Math.min(week,40)/40);
        const status=isUnderweight?'Below recommended range':isOverweight?'Above recommended range':'Within recommended range';
        const statusColor=isUnderweight?'text-amber-600':isOverweight?'text-red-600':'text-emerald-600';
        const weightDistribution=[
          {item:'Enlarged breasts',range:'0.5-1.4 kg (1-3 lbs)'},
          {item:'Enlarged uterus',range:'~0.9 kg (~2 lbs)'},
          {item:'Placenta',range:'~0.7 kg (~1.5 lbs)'},
          {item:'Amniotic fluid',range:'~0.9 kg (~2 lbs)'},
          {item:'Increased blood volume',range:'1.4-1.8 kg (3-4 lbs)'},
          {item:'Increased fluid volume',range:'0.9-1.4 kg (2-3 lbs)'},
          {item:'Fat stores',range:'2.7-3.6 kg (6-8 lbs)'},
          {item:'Baby (at birth)',range:'~3.4 kg (~7.5 lbs)'},
        ];
        let weekScheduleHTML='<div class="mt-4"><p class="text-xs font-semibold tracking-[.08em] text-[var(--muted)] mb-3">IOM WEIGHT GAIN GUIDELINES BY BMI</p><div class="rounded-xl border overflow-hidden" style="border-color:var(--line)"><table class="w-full text-left text-sm"><thead class="bg-[var(--soft)]"><tr><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">BMI Category</th><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">BMI Range</th><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Singleton (kg/lbs)</th><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Twins (kg/lbs)</th></tr></thead><tbody>';
        const bmiRows=[
          {cat:'Underweight',range:'< 18.5',s:[12.5,18],t:[22.5,31.5]},
          {cat:'Normal',range:'18.5-24.9',s:[11.5,16],t:[16.8,24.5]},
          {cat:'Overweight',range:'25.0-29.9',s:[7,11.5],t:[14.1,22.7]},
          {cat:'Obese',range:'>= 30.0',s:[5,9],t:[11.3,19.1]},
        ];
        for(const row of bmiRows){
          const isCurrent=row.cat.toLowerCase()===bmiCat.toLowerCase().split(' ')[0];
          weekScheduleHTML+='<tr class="'+(isCurrent?'bg-[var(--color-primary)]/5 font-semibold':'')+' border-t" style="border-color:var(--line)"><td class="px-3 py-2 text-xs">'+(isCurrent?'> ':'')+row.cat+'</td><td class="px-3 py-2 text-xs">'+row.range+'</td><td class="px-3 py-2 text-xs">'+row.s[0]+'-'+row.s[1]+' kg ('+Math.round(row.s[0]*2.20462)+'-'+Math.round(row.s[1]*2.20462)+' lbs)</td><td class="px-3 py-2 text-xs">'+row.t[0]+'-'+row.t[1]+' kg ('+Math.round(row.t[0]*2.20462)+'-'+Math.round(row.t[1]*2.20462)+' lbs)</td></tr>';
        }
        weekScheduleHTML+='</tbody></table></div></div>';
        let distHTML='<div class="mt-4"><p class="text-xs font-semibold tracking-[.08em] text-[var(--muted)] mb-3">PREGNANCY WEIGHT GAIN DISTRIBUTION</p><div class="rounded-xl border overflow-hidden" style="border-color:var(--line)"><table class="w-full text-left text-sm"><thead class="bg-[var(--soft)]"><tr><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Component</th><th class="px-3 py-2 text-xs font-semibold text-[var(--muted)]">Weight Gain</th></tr></thead><tbody>';
        for(const d of weightDistribution) distHTML+='<tr class="border-t" style="border-color:var(--line)"><td class="px-3 py-2 text-xs">'+d.item+'</td><td class="px-3 py-2 text-xs text-[var(--muted)]">'+d.range+'</td></tr>';
        distHTML+='</tbody></table></div></div>';
        output=card('PRE-PREGNANCY BMI',number(bmi,1)+' ('+bmiCat+')','BMI = weight / height²',true)
          +card('RECOMMENDED TOTAL GAIN',minGain+'-'+maxGain+' kg ('+Math.round(totalMinLbs)+'-'+Math.round(totalMaxLbs)+' lbs)',twins?'Twins guideline':'Singleton guideline, IOM 2009')
          +card('WEIGHT GAIN SO FAR',number(gainSoFar,1)+' kg ('+number(gainLbs,1)+' lbs)','Since pre-pregnancy')
          +card('EXPECTED BY WEEK '+week,number(minGain*(Math.min(week,40)/40),1)+'-'+number(maxGain*(Math.min(week,40)/40),1)+' kg','Based on linear IOM trajectory')
          +card('STATUS','<span class="'+statusColor+'">'+status+'</span>','Compared to IOM guidelines for '+bmiCat+' BMI')
          +card('WEEKLY TARGET (2nd-3rd)',number(avgGain/27,1)+' kg/week ('+number(avgGain/27*2.20462,1)+' lbs/week)','~300 extra kcal/day')
          +card('FIRST TRIMESTER GAIN','1-4 kg (2-8 lbs)','Total recommended for weeks 1-13')
          +card('WEEKS REMAINING',weeksRemaining23+' weeks','Until due date (week 40)')
          +weekScheduleHTML+distHTML;}
      if (kind === 'body-type') { const bust=n('bust'), waist=n('waist'), hip=n('hip'), ratio=waist/hip; const shape=Math.abs(bust-hip)<=hip*.05?(waist<=hip*.75?'Hourglass':'Rectangle'):bust>hip*1.05?'Inverted triangle':'Triangle'; const risk=ratio>(s('sex')==='male'?.9:.85)?'Higher cardiometabolic risk':'Lower cardiometabolic risk'; const whrRisk=ratio>(s('sex')==='male'?.9:.85)?'Above healthy threshold':'Within healthy range'; output=card('BODY SHAPE',shape)+card('WAIST-TO-HIP RATIO',number(ratio,2),whrRisk)+card('HEALTH RISK',risk,`WHO threshold: ${s('sex')==='male'?'>0.90':'>0.85'}`)+card('MEASUREMENT DIFFERENCE',`${number(Math.abs(bust-hip),1)} cm`,'Bust vs hip difference'); }
      if (kind === 'roas') { const roas=safeDivide(n('revenue'),n('spend')), profit=n('revenue')-n('spend'); output=card('ROAS',`${number(roas,2)}x`,`${number(roas*100,0)}% return on ad spend`)+card('REVENUE',money(n('revenue')))+card('REVENUE MINUS AD SPEND',money(profit)); }
      if (kind === 'break-even-roas') { const margin=n('margin')/100, roas=safeDivide(1,margin), grossProfit=n('aov')*margin; output=card('BREAK-EVEN ROAS',`${number(roas,2)}x`)+card('BREAK-EVEN REVENUE / $1',money(roas))+card('GROSS PROFIT / ORDER',money(grossProfit),'Before advertising cost'); }
      if (kind === 'ad-spend') { const spend=safeDivide(n('revenue'),n('target')); output=card('MAX AD SPEND',money(spend))+card('DAILY BUDGET',money(safeDivide(spend,n('days'))))+card('TARGET ROAS',`${number(n('target'),2)}x`); }
      if (kind === 'cac') { const total=n('marketing')+n('sales'), cac=safeDivide(total,n('customers')); output=card('CUSTOMER ACQUISITION COST',money(cac))+card('TOTAL ACQUISITION COST',money(total))+card('NEW CUSTOMERS',number(n('customers'),0)); }
      if (kind === 'ltv') { const revenue=n('aov')*n('frequency')*n('years'), gross=revenue*n('margin')/100; output=card('GROSS-PROFIT LTV',money(gross))+card('REVENUE LTV',money(revenue))+card('ANNUAL CUSTOMER VALUE',money(n('aov')*n('frequency'))); }
      if (kind === 'cpc') { const cpc=safeDivide(n('spend'),n('clicks')); output=card('AVERAGE CPC',money(cpc))+card('TOTAL SPEND',money(n('spend')))+card('CLICKS',number(n('clicks'),0)); }
      if (kind === 'cpm') { const cpm=safeDivide(n('spend'),n('impressions')/1000); output=card('CPM',money(cpm))+card('COST PER IMPRESSION',money(safeDivide(n('spend'),n('impressions'))))+card('IMPRESSIONS',number(n('impressions'),0)); }
      if (kind === 'cpa') { const cpa=safeDivide(n('spend'),n('conversions')); output=card('COST PER ACQUISITION',money(cpa))+card('TOTAL SPEND',money(n('spend')))+card('ACQUISITIONS',number(n('conversions'),0)); }
      if (kind === 'conversion-rate') { const rate=safeDivide(n('conversions'),n('visitors'))*100; output=card('CONVERSION RATE',`${number(rate,2)}%`)+card('CONVERSIONS',number(n('conversions'),0))+card('VISITORS PER CONVERSION',number(safeDivide(n('visitors'),n('conversions')),1)); }
      if (kind === 'profit-margin') { const gross=n('revenue')-n('cogs'), net=gross-n('expenses'); output=card('NET PROFIT MARGIN',`${number(safeDivide(net,n('revenue'))*100,2)}%`)+card('GROSS MARGIN',`${number(safeDivide(gross,n('revenue'))*100,2)}%`)+card('NET PROFIT',money(net)); }
      const result=root.querySelector<HTMLElement>('[data-general-result]')!, metrics=root.querySelector<HTMLElement>('[data-general-metrics]')!, error=root.querySelector<HTMLElement>('[data-general-error]')!;
      if (hasInvalid(output)) { error.textContent='Enter valid values in every field.'; error.classList.remove('hidden'); result.classList.add('hidden'); return; }
      error.classList.add('hidden'); metrics.innerHTML=output; result.classList.remove('hidden');
      const existingCharts = root.querySelectorAll('.amortization-wrap, .donut-chart-wrap');
      existingCharts.forEach(el => el.remove());
      if (amortData && amortData.length > 0) {
        const maxShow = Math.min(amortData.length, 360);
        const tableWrap = document.createElement('div');
        tableWrap.className = 'amortization-wrap';
        let tableHTML = `<details class="amortization-details"><summary class="amortization-toggle"><span class="amortization-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 4-6"/></svg></span><span>Amortization Schedule</span><span class="amortization-count">${amortData.length} payments</span><span class="amortization-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span></summary><div class="amortization-table-wrap"><table class="amortization-table"><thead><tr><th>#</th><th>Payment</th><th>Principal</th><th>Interest</th><th>Total Interest</th><th>Balance</th></tr></thead><tbody>`;
        for (let i = 0; i < maxShow; i++) {
          const row = amortData[i];
          const f = (v: number) => '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          tableHTML += `<tr><td>${row.month}</td><td>${f(row.payment)}</td><td>${f(row.principal)}</td><td>${f(row.interest)}</td><td>${f(row.totalInterest)}</td><td>${f(Math.max(0, row.balance))}</td></tr>`;
        }
        tableHTML += '</tbody></table></div></details>';
        tableWrap.innerHTML = tableHTML;
        result.appendChild(tableWrap);
      }
      if (donutData && donutData.length > 0) {
        const total = donutData.reduce((s: number, seg: any) => s + seg.value, 0);
        if (total > 0) {
          let cumulative = 0;
          const gradParts: string[] = [];
          for (const seg of donutData) {
            const pct = seg.value / total * 100;
            gradParts.push(`${seg.color} ${cumulative}% ${cumulative + pct}%`);
            cumulative += pct;
          }
          const chartWrap = document.createElement('div');
          chartWrap.className = 'donut-chart-wrap';
          let legendHTML = '';
          for (const seg of donutData) {
            const pct = (seg.value / total * 100).toFixed(1);
            legendHTML += `<div class="donut-legend-item"><span class="donut-swatch" style="background:${seg.color}"></span><span class="donut-legend-label">${seg.label}</span><span class="donut-legend-value">$${seg.value.toLocaleString('en-US', { maximumFractionDigits: 0 })}</span><span class="donut-legend-pct">${pct}%</span></div>`;
          }
          chartWrap.innerHTML = `<p class="donut-title">Payment Breakdown</p><div class="donut-layout"><div class="donut-container"><div class="donut-ring" style="background:conic-gradient(${gradParts.join(',')})"><div class="donut-hole"><span class="donut-total-label">Total</span><span class="donut-total-value">$${total.toLocaleString('en-US', { maximumFractionDigits: 0 })}</span></div></div></div><div class="donut-legend">${legendHTML}</div></div>`;
          result.appendChild(chartWrap);
        }
      }
      result.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth', block:'nearest' });
    });
    root.querySelectorAll('input[type="number"]').forEach((input) => {
      input.addEventListener('input', () => {
        const el = input as HTMLInputElement;
        if (el.validity.valid || el.value === '') { el.style.borderColor = ''; } else { el.style.borderColor = '#dc2626'; }
      });
    });
  });
</script>
