---
import type { GeneralTool } from '../data/calculatorCatalog';
const { tool } = Astro.props as { tool: GeneralTool };
type Field = { key: string; label: string; value: string | number; type?: 'date' | 'number'; min?: number; max?: number; step?: number; options?: [string, string][] };
const commonBody: Field[] = [
  { key: 'age', label: 'Age', value: 30, min: 14 },
  { key: 'sex', label: 'Sex', value: 'male', options: [['male', 'Male'], ['female', 'Female']] },
  { key: 'weight', label: 'Weight (kg)', value: 70, min: 1, step: .1 },
  { key: 'height', label: 'Height (cm)', value: 175, min: 50, step: .1 },
];
const schemas: Record<string, Field[]> = {
  loan: [{ key: 'principal', label: 'Loan amount', value: 250000, min: 1, step: 100 }, { key: 'rate', label: 'Annual interest (%)', value: 6.5, min: 0, step: .01 }, { key: 'years', label: 'Loan term (years)', value: 30, min: .1, step: 1 }, { key: 'extra', label: 'Extra monthly payment', value: 0, min: 0, step: 10 }],
  investment: [{ key: 'principal', label: 'Starting amount', value: 10000, min: 0, step: 100 }, { key: 'monthly', label: 'Monthly contribution', value: 250, min: 0, step: 10 }, { key: 'rate', label: 'Annual return (%)', value: 7, step: .1 }, { key: 'years', label: 'Time (years)', value: 10, min: .1, step: 1 }],
  'simple-interest': [{ key: 'principal', label: 'Principal amount', value: 10000, min: 0 }, { key: 'rate', label: 'Annual interest (%)', value: 5, step: .1 }, { key: 'years', label: 'Time (years)', value: 3, min: 0, step: .1 }],
  percentage: [{ key: 'cost', label: 'Original / cost value', value: 100, step: .01 }, { key: 'final', label: 'Final / selling value', value: 125, step: .01 }],
  'debt-ratio': [{ key: 'income', label: 'Gross monthly income', value: 6000, min: 1 }, { key: 'debt', label: 'Monthly debt payments', value: 1500, min: 0 }, { key: 'housing', label: 'Monthly housing cost', value: 1800, min: 0 }],
  salary: [{ key: 'amount', label: 'Pay amount', value: 25, min: 0, step: .01 }, { key: 'frequency', label: 'Pay frequency', value: 'hour', options: [['hour', 'Per hour'], ['week', 'Per week'], ['month', 'Per month'], ['year', 'Per year']] }, { key: 'hours', label: 'Hours per week', value: 40, min: 1 }, { key: 'weeks', label: 'Working weeks per year', value: 52, min: 1, max: 52 }],
  lease: [{ key: 'value', label: 'Asset value', value: 35000, min: 0 }, { key: 'residual', label: 'Residual value', value: 18000, min: 0 }, { key: 'rate', label: 'Annual interest (%)', value: 5, min: 0, step: .1 }, { key: 'months', label: 'Lease term (months)', value: 36, min: 1 }],
  depreciation: [{ key: 'value', label: 'Initial value', value: 30000, min: 0 }, { key: 'residual', label: 'Salvage value', value: 5000, min: 0 }, { key: 'years', label: 'Useful life (years)', value: 5, min: 1 }, { key: 'elapsed', label: 'Years elapsed', value: 2, min: 0 }],
  budget: [{ key: 'income', label: 'Monthly income', value: 5000, min: 0 }, { key: 'housing', label: 'Housing', value: 1500, min: 0 }, { key: 'needs', label: 'Other needs', value: 1000, min: 0 }, { key: 'wants', label: 'Wants', value: 750, min: 0 }, { key: 'savings', label: 'Savings & debt payoff', value: 1000, min: 0 }],
  currency: [{ key: 'amount', label: 'Amount', value: 1000, min: 0, step: .01 }, { key: 'rate', label: 'Conversion / inflation rate', value: 1.08, min: 0, step: .0001 }, { key: 'years', label: 'Years (use 1 for currency)', value: 1, min: 0, step: 1 }],
  tax: [{ key: 'income', label: 'Amount before tax', value: 50000, min: 0 }, { key: 'deductions', label: 'Deductions / exemptions', value: 0, min: 0 }, { key: 'rate', label: 'Applicable tax rate (%)', value: 20, min: 0, step: .01 }],
  bmi: commonBody.slice(2),
  calories: [...commonBody, { key: 'activity', label: 'Activity level', value: '1.55', options: [['1.2', 'Sedentary'], ['1.375', 'Light activity'], ['1.55', 'Moderate activity'], ['1.725', 'Very active'], ['1.9', 'Extra active']] }],
  'body-fat': [...commonBody, { key: 'neck', label: 'Neck (cm)', value: 38, min: 1, step: .1 }, { key: 'waist', label: 'Waist (cm)', value: 85, min: 1, step: .1 }, { key: 'hip', label: 'Hip (cm, women)', value: 95, min: 1, step: .1 }],
  'ideal-weight': commonBody.filter((field) => ['sex', 'height'].includes(field.key)),
  'lean-mass': commonBody.filter((field) => ['sex', 'weight', 'height'].includes(field.key)),
  'one-rep-max': [{ key: 'weight', label: 'Weight lifted', value: 80, min: 1, step: .5 }, { key: 'reps', label: 'Repetitions', value: 5, min: 1, max: 15 }],
  'heart-rate': [{ key: 'age', label: 'Age', value: 30, min: 14 }, { key: 'resting', label: 'Resting heart rate', value: 60, min: 30 }, { key: 'intensity', label: 'Target intensity (%)', value: 70, min: 40, max: 100 }],
  pregnancy: [{ key: 'date', label: 'First day of last period', value: '2026-08-01', type: 'date' }, { key: 'cycle', label: 'Average cycle length (days)', value: 28, min: 20, max: 45 }],
  cycle: [{ key: 'date', label: 'First day of last period', value: '2026-08-01', type: 'date' }, { key: 'cycle', label: 'Average cycle length (days)', value: 28, min: 20, max: 45 }, { key: 'period', label: 'Period length (days)', value: 5, min: 1, max: 10 }],
  macros: [...commonBody, { key: 'activity', label: 'Activity level', value: '1.55', options: [['1.2', 'Sedentary'], ['1.375', 'Light'], ['1.55', 'Moderate'], ['1.725', 'Very active']] }],
  protein: [{ key: 'weight', label: 'Weight (kg)', value: 70, min: 1, step: .1 }, { key: 'activity', label: 'Activity', value: '1.2', options: [['0.8', 'Low activity'], ['1.2', 'Regular exercise'], ['1.6', 'Strength / endurance'], ['2', 'Intense training']] }],
  'calories-burned': [{ key: 'weight', label: 'Weight (kg)', value: 70, min: 1 }, { key: 'minutes', label: 'Duration (minutes)', value: 30, min: 1 }, { key: 'met', label: 'Activity intensity (MET)', value: 8, min: 1, step: .1 }],
  bsa: [{ key: 'weight', label: 'Weight (kg)', value: 70, min: 1 }, { key: 'height', label: 'Height (cm)', value: 175, min: 1 }],
  bac: [{ key: 'sex', label: 'Sex', value: 'male', options: [['male', 'Male'], ['female', 'Female']] }, { key: 'weight', label: 'Weight (kg)', value: 70, min: 1 }, { key: 'drinks', label: 'Standard drinks', value: 2, min: 0, step: 1 }, { key: 'hours', label: 'Hours since first drink', value: 2, min: 0, step: .5 }],
  gfr: [{ key: 'age', label: 'Age', value: 45, min: 18 }, { key: 'sex', label: 'Sex', value: 'male', options: [['male', 'Male'], ['female', 'Female']] }, { key: 'creatinine', label: 'Serum creatinine (mg/dL)', value: 1, min: .1, step: .01 }],
  'pregnancy-weight': [{ key: 'height', label: 'Height (cm)', value: 165, min: 100 }, { key: 'preweight', label: 'Pre-pregnancy weight (kg)', value: 60, min: 30, step: .1 }, { key: 'current', label: 'Current weight (kg)', value: 68, min: 30, step: .1 }, { key: 'week', label: 'Pregnancy week', value: 24, min: 1, max: 42 }],
  'body-type': [{ key: 'bust', label: 'Bust (cm)', value: 92, min: 1, step: .1 }, { key: 'waist', label: 'Waist (cm)', value: 72, min: 1, step: .1 }, { key: 'hip', label: 'Hip (cm)', value: 98, min: 1, step: .1 }],
  roas: [{ key: 'spend', label: 'Ad spend', value: 5000, min: 0, step: .01 }, { key: 'revenue', label: 'Revenue attributed to ads', value: 20000, min: 0, step: .01 }],
  'break-even-roas': [{ key: 'margin', label: 'Gross margin (%)', value: 40, min: .01, max: 100, step: .01 }, { key: 'aov', label: 'Average order value', value: 100, min: 0, step: .01 }],
  'ad-spend': [{ key: 'revenue', label: 'Target revenue', value: 50000, min: 0, step: .01 }, { key: 'target', label: 'Target ROAS', value: 4, min: .01, step: .01 }, { key: 'days', label: 'Campaign length (days)', value: 30, min: 1 }],
  cac: [{ key: 'marketing', label: 'Marketing costs', value: 10000, min: 0, step: .01 }, { key: 'sales', label: 'Sales costs', value: 5000, min: 0, step: .01 }, { key: 'customers', label: 'New customers acquired', value: 150, min: 1 }],
  ltv: [{ key: 'aov', label: 'Average order value', value: 75, min: 0, step: .01 }, { key: 'frequency', label: 'Purchases per year', value: 4, min: 0, step: .1 }, { key: 'years', label: 'Customer lifespan (years)', value: 3, min: 0, step: .1 }, { key: 'margin', label: 'Gross margin (%)', value: 50, min: 0, max: 100, step: .1 }],
  cpc: [{ key: 'spend', label: 'Total ad spend', value: 2500, min: 0, step: .01 }, { key: 'clicks', label: 'Total clicks', value: 1250, min: 1 }],
  cpm: [{ key: 'spend', label: 'Total ad spend', value: 2500, min: 0, step: .01 }, { key: 'impressions', label: 'Total impressions', value: 500000, min: 1 }],
  cpa: [{ key: 'spend', label: 'Total ad spend', value: 5000, min: 0, step: .01 }, { key: 'conversions', label: 'Acquisitions / conversions', value: 200, min: 1 }],
  'conversion-rate': [{ key: 'conversions', label: 'Conversions', value: 250, min: 0 }, { key: 'visitors', label: 'Visitors / clicks', value: 10000, min: 1 }],
  'profit-margin': [{ key: 'revenue', label: 'Revenue', value: 50000, min: 0, step: .01 }, { key: 'cogs', label: 'Cost of goods sold', value: 25000, min: 0, step: .01 }, { key: 'expenses', label: 'Other operating expenses', value: 10000, min: 0, step: .01 }],
};
const fields = tool.name === 'Army Body Fat Calculator'
  ? [commonBody[1], commonBody[2], { key: 'waist', label: 'Waist (cm)', value: 85, min: 1, step: .1 }]
  : tool.name === 'Commission Calculator'
    ? [{ key: 'income', label: 'Sales amount', value: 50000, min: 0 }, { key: 'deductions', label: 'Base pay', value: 0, min: 0 }, { key: 'rate', label: 'Commission rate (%)', value: 5, min: 0, step: .01 }]
    : schemas[tool.kind];
const financial = tool.category === 'Financial';
const marketing = tool.category === 'Marketing';
---
<section class="panel overflow-hidden" data-general-calculator data-kind={tool.kind} data-name={tool.name}>
  <div class="border-b bg-[var(--soft)] px-5 py-4 sm:px-6" style="border-color:var(--line)">
    <div class="flex items-center gap-3"><span class="grid size-9 place-items-center rounded-xl bg-[var(--panel)] text-[var(--color-primary)] shadow-sm"><svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M7 4v6M6 14h4M14 14h4M6 18h4M14 18h4"/></svg></span><div><h2 class="font-[var(--font-display)] font-bold tracking-[-.025em]">Calculate your result</h2><p class="mt-0.5 text-xs text-[var(--muted)]">Adjust the values to match your scenario.</p></div></div>
  </div>
  <form class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6" data-general-form>
    {fields.map((field) => <div class="field">
      <label for={`${tool.slug}-${field.key}`}>{field.label}</label>
      {field.options ? <select class="control" id={`${tool.slug}-${field.key}`} name={field.key}>{field.options.map(([value, label]) => <option value={value} selected={value === field.value}>{label}</option>)}</select> : <input class="control" id={`${tool.slug}-${field.key}`} name={field.key} type={field.type ?? 'number'} value={field.value} min={field.min} max={field.max} step={field.step ?? 1} required />}
    </div>)}
    <p class="hidden rounded-lg bg-red-100 p-3 text-sm font-medium text-red-800 sm:col-span-2" data-general-error role="alert"></p>
    <button class="primary sm:col-span-2" type="submit">Calculate result</button>
  </form>
  <div class="hidden border-t bg-[var(--soft)] p-5 sm:p-6" style="border-color:var(--line)" data-general-result aria-live="polite">
    <p class="text-xs font-semibold tracking-[.08em] text-[var(--muted)]">ESTIMATED RESULT</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-3" data-general-metrics></div>
    <p class="mt-4 text-xs leading-5 text-[var(--muted)]">{financial ? 'Planning estimate only. Rates, fees, taxes and product rules vary by provider and jurisdiction.' : marketing ? 'Performance estimate only. Use consistent attribution windows, currencies, channels, and revenue definitions when comparing campaigns.' : 'Educational estimate only. This result is not medical advice or a diagnosis.'}</p>
  </div>
</section>

<script>
  const money = (value: number) => new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(value);
  const number = (value: number, digits = 1) => new Intl.NumberFormat(undefined, { maximumFractionDigits: digits }).format(value);
  const card = (label: string, value: string, note = '') => `<div class="result-metric"><div class="result-label">${label}</div><div class="result-value">${value}</div>${note ? `<div class="result-note">${note}</div>` : ''}</div>`;
  const safeDivide = (a: number, b: number, fallback = 0) => (!b || !Number.isFinite(b)) ? fallback : a / b;
  const hasInvalid = (html: string) => !html || /NaN|Infinity|undefined|null/.test(html);
  document.querySelectorAll<HTMLElement>('[data-general-calculator]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-general-form]')!;
    form.addEventListener('submit', (event) => {
      event.preventDefault(); const data = new FormData(form); const n = (key: string) => Number(data.get(key)); const s = (key: string) => String(data.get(key)); const kind = root.dataset.kind; const name = root.dataset.name!; let output = '';
      if (kind === 'loan') { const p=n('principal'), r=n('rate')/1200, months=n('years')*12, base=r?p*r*(1+r)**months/((1+r)**months-1):p/months, payment=base+n('extra'), payoff=r&&payment>p*r?-Math.log(1-p*r/payment)/Math.log(1+r):months, total=payment*Math.min(months,payoff); output=card('MONTHLY PAYMENT',money(payment))+card('TOTAL INTEREST',money(Math.max(0,total-p)))+card('PAYOFF TIME',`${number(payoff/12,1)} years`); }
      if (kind === 'investment') { const p=n('principal'), c=n('monthly'), r=n('rate')/1200, months=n('years')*12, fv=p*(1+r)**months+(r?c*((1+r)**months-1)/r:c*months), contributed=p+c*months; output=card('ENDING BALANCE',money(fv))+card('CONTRIBUTIONS',money(contributed))+card('ESTIMATED GROWTH',money(fv-contributed)); }
      if (kind === 'simple-interest') { const interest=n('principal')*n('rate')/100*n('years'); output=card('TOTAL INTEREST',money(interest))+card('ENDING BALANCE',money(n('principal')+interest))+card('ANNUAL INTEREST',money(safeDivide(interest,n('years')))); }
      if (kind === 'percentage') { const cost=n('cost'), final=n('final'), change=(final-cost)/cost*100; output=card(name.includes('Margin')?'GROSS MARGIN':'PERCENT CHANGE',`${number(name.includes('Margin')?(final-cost)/final*100:change,2)}%`)+card('DIFFERENCE',money(final-cost))+card('FINAL VALUE',money(final)); }
      if (kind === 'debt-ratio') { const income=n('income'), debt=n('debt'), housing=n('housing'); output=card('DEBT-TO-INCOME',`${number(safeDivide(debt+housing,income)*100,1)}%`)+card('HOUSING RATIO',`${number(safeDivide(housing,income)*100,1)}%`)+card('AFTER FIXED COSTS',money(income-debt-housing)); }
      if (kind === 'salary') { const amount=n('amount'), f=s('frequency'), annual=f==='hour'?amount*n('hours')*n('weeks'):f==='week'?amount*n('weeks'):f==='month'?amount*12:amount; output=card('ANNUAL',money(annual))+card('MONTHLY',money(annual/12))+card('WEEKLY',money(annual/52)); }
      if (kind === 'lease') { const months=n('months'), depreciation=(n('value')-n('residual'))/months, finance=(n('value')+n('residual'))*n('rate')/2400, payment=depreciation+finance; output=card('MONTHLY PAYMENT',money(payment))+card('TOTAL PAYMENTS',money(payment*months))+card('DEPRECIATION / MONTH',money(depreciation)); }
      if (kind === 'depreciation') { const annual=(n('value')-n('residual'))/n('years'), current=Math.max(n('residual'),n('value')-annual*n('elapsed')); output=card('CURRENT VALUE',money(current))+card('ANNUAL DEPRECIATION',money(annual))+card('ACCUMULATED',money(n('value')-current)); }
      if (kind === 'budget') { const spent=n('housing')+n('needs')+n('wants')+n('savings'), left=n('income')-spent; output=card('MONEY LEFT',money(left))+card('TOTAL ALLOCATED',money(spent))+card('SAVINGS RATE',`${number(safeDivide(n('savings'),n('income'))*100,1)}%`); }
      if (kind === 'currency') { const result=name.includes('Inflation')?n('amount')*(1+n('rate')/100)**n('years'):n('amount')*n('rate'); output=card('CONVERTED VALUE',money(result))+card('STARTING VALUE',money(n('amount')))+card('CHANGE',money(result-n('amount'))); }
      if (kind === 'tax') { const taxable=Math.max(0,n('income')-n('deductions')), tax=taxable*n('rate')/100; output=name.includes('Commission')?card('COMMISSION',money(tax))+card('TOTAL COMPENSATION',money(tax+n('deductions')))+card('COMMISSION RATE',`${number(n('rate'),2)}%`):name.includes('Sales Tax')||name.includes('VAT')?card('TAX AMOUNT',money(tax))+card('TOTAL WITH TAX',money(n('income')+tax))+card('TAX RATE',`${number(n('rate'),2)}%`):card('ESTIMATED TAX',money(tax))+card('AFTER TAX',money(n('income')-tax))+card('TAXABLE AMOUNT',money(taxable)); }
      if (kind === 'bmi') { const h=n('height')/100, bmi=safeDivide(n('weight'),h**2), category=bmi<18.5?'Underweight':bmi<25?'Healthy range':bmi<30?'Overweight':'Obesity range'; output=card('BMI',number(bmi,1),category)+card('HEALTHY WEIGHT',`${number(18.5*h*h,1)}–${number(24.9*h*h,1)} kg`)+card('BMI PRIME',number(safeDivide(bmi,25),2)); }
      if (kind === 'calories' || kind === 'macros') { const bmr=10*n('weight')+6.25*n('height')-5*n('age')+(s('sex')==='male'?5:-161), tdee=bmr*n('activity'); output=kind==='macros'?card('DAILY CALORIES',`${number(tdee,0)} kcal`)+card('PROTEIN',`${number(tdee*.25/4,0)} g`)+card('CARBS / FAT',`${number(tdee*.45/4,0)} g / ${number(tdee*.3/9,0)} g`):card('BMR',`${number(bmr,0)} kcal`)+card('MAINTENANCE',`${number(tdee,0)} kcal`)+card('MODERATE LOSS',`${number(Math.max(1200,tdee-500),0)} kcal`); }
      if (kind === 'body-fat') { const female=s('sex')==='female'; let bf=0; if(name.includes('Army')) { const waist=n('waist')/2.54, pounds=n('weight')*2.20462; bf=female?1.27*waist-.015*pounds-9.15:1.99*waist-.12*pounds-26.97; } else { const h=n('height')/2.54, neck=n('neck')/2.54, waist=n('waist')/2.54, hip=n('hip')/2.54; bf=female?163.205*Math.log10(waist+hip-neck)-97.684*Math.log10(h)-78.387:86.01*Math.log10(waist-neck)-70.041*Math.log10(h)+36.76; } output=card('BODY FAT',`${number(bf,1)}%`)+card('FAT MASS',`${number(n('weight')*bf/100,1)} kg`)+card('LEAN MASS',`${number(n('weight')*(1-bf/100),1)} kg`); }
      if (kind === 'ideal-weight') { const inches=n('height')/2.54, extra=Math.max(0,inches-60), female=s('sex')==='female', devine=(female?45.5:50)+2.3*extra, h=n('height')/100; output=card('DEVINE ESTIMATE',`${number(devine,1)} kg`)+card('BMI-BASED RANGE',`${number(18.5*h*h,1)}–${number(24.9*h*h,1)} kg`)+card('HEIGHT',`${number(inches,1)} in`); }
      if (kind === 'lean-mass') { const female=s('sex')==='female', lbm=female ? .252*n('weight')+.473*n('height')-48.3 : .407*n('weight')+.267*n('height')-19.2; output=card('LEAN BODY MASS',`${number(lbm,1)} kg`)+card('ESTIMATED FAT MASS',`${number(n('weight')-lbm,1)} kg`)+card('LEAN PERCENT',`${number(safeDivide(lbm,n('weight'))*100,1)}%`); }
      if (kind === 'one-rep-max') { const epley=n('weight')*(1+n('reps')/30), brzycki=36*n('weight')/(37-n('reps')); output=card('ESTIMATED 1RM',number((epley+brzycki)/2,1))+card('Epley',number(epley,1))+card('Brzycki',number(brzycki,1)); }
      if (kind === 'heart-rate') { const max=208-.7*n('age'), target=n('resting')+n('intensity')/100*(max-n('resting')); output=card('TARGET HEART RATE',`${number(target,0)} bpm`)+card('ESTIMATED MAX',`${number(max,0)} bpm`)+card('HEART RATE RESERVE',`${number(max-n('resting'),0)} bpm`); }
      if (kind === 'pregnancy' || kind === 'cycle') { const date=new Date(`${s('date')}T12:00:00`), cycle=n('cycle'), ovulation=new Date(date); ovulation.setDate(ovulation.getDate()+cycle-14); const due=new Date(date); due.setDate(due.getDate()+280+(cycle-28)); const next=new Date(date); next.setDate(next.getDate()+cycle); const fmt=(d:Date)=>new Intl.DateTimeFormat(undefined,{dateStyle:'medium'}).format(d); output=card('ESTIMATED OVULATION',fmt(ovulation))+card(kind==='pregnancy'?'ESTIMATED DUE DATE':'NEXT PERIOD',fmt(kind==='pregnancy'?due:next))+card('FERTILE WINDOW',`${fmt(new Date(ovulation.getTime()-5*864e5))} – ${fmt(new Date(ovulation.getTime()+864e5))}`); }
      if (kind === 'protein') { const grams=n('weight')*n('activity'); output=card('DAILY PROTEIN',`${number(grams,0)} g`)+card('PER MEAL (4)',`${number(grams/4,0)} g`)+card('PER KG',`${n('activity')} g/kg`); }
      if (kind === 'calories-burned') { const kcal=n('minutes')*n('met')*3.5*n('weight')/200; output=card('CALORIES BURNED',`${number(kcal,0)} kcal`)+card('PER HOUR',`${number(safeDivide(kcal,n('minutes'))*60,0)} kcal`)+card('MET VALUE',number(n('met'),1)); }
      if (kind === 'bsa') { const mosteller=Math.sqrt(n('weight')*n('height')/3600), dubois=.007184*n('weight')**.425*n('height')**.725; output=card('MOSTELLER BSA',`${number(mosteller,2)} m²`)+card('DU BOIS BSA',`${number(dubois,2)} m²`)+card('AVERAGE',`${number((mosteller+dubois)/2,2)} m²`); }
      if (kind === 'bac') { const alcohol=n('drinks')*14, ratio=s('sex')==='female'?.55:.68, bac=Math.max(0,alcohol/(n('weight')*1000*ratio)*100-.015*n('hours')); output=card('ESTIMATED BAC',`${number(bac,3)}%`)+card('STANDARD DRINKS',number(n('drinks'),0))+card('SAFETY','Do not drive','BAC estimates are not measurements'); }
      if (kind === 'gfr') { const female=s('sex')==='female', k=female ? .7 : .9, a=female ? -.241 : -.302, scr=n('creatinine'), egfr=142*Math.min(scr/k,1)**a*Math.max(scr/k,1)**-1.2*.9938**n('age')*(female?1.012:1); output=card('ESTIMATED GFR',`${number(egfr,0)} mL/min/1.73m²`)+card('EQUATION','2021 CKD-EPI','Race-free creatinine equation')+card('IMPORTANT','Discuss clinically','One result cannot diagnose CKD'); }
      if (kind === 'pregnancy-weight') { const h=n('height')/100, bmi=n('preweight')/h**2; const range=bmi<18.5?[12.5,18]:bmi<25?[11.5,16]:bmi<30?[7,11.5]:[5,9]; const progress=Math.max(0,Math.min(1,(n('week')-13)/27)), low=range[0]*progress, high=2+range[1]*progress; output=card('PRE-PREGNANCY BMI',number(bmi,1))+card('RECOMMENDED TOTAL',`${range[0]}–${range[1]} kg`)+card('GAIN SO FAR',`${number(n('current')-n('preweight'),1)} kg`, `Approx. range by week ${n('week')}: ${number(low,1)}–${number(high,1)} kg`); }
      if (kind === 'body-type') { const bust=n('bust'), waist=n('waist'), hip=n('hip'), ratio=waist/hip; const shape=Math.abs(bust-hip)<=hip*.05?(waist<=hip*.75?'Hourglass':'Rectangle'):bust>hip*1.05?'Inverted triangle':'Triangle'; output=card('BODY SHAPE',shape)+card('WAIST-TO-HIP RATIO',number(ratio,2))+card('MEASUREMENT DIFFERENCE',`${number(Math.abs(bust-hip),1)} cm`); }
      if (kind === 'roas') { const roas=safeDivide(n('revenue'),n('spend')), profit=n('revenue')-n('spend'); output=card('ROAS',`${number(roas,2)}x`,`${number(roas*100,0)}% return on ad spend`)+card('REVENUE',money(n('revenue')))+card('REVENUE MINUS AD SPEND',money(profit)); }
      if (kind === 'break-even-roas') { const margin=n('margin')/100, roas=safeDivide(1,margin), grossProfit=n('aov')*margin; output=card('BREAK-EVEN ROAS',`${number(roas,2)}x`)+card('BREAK-EVEN REVENUE / $1',money(roas))+card('GROSS PROFIT / ORDER',money(grossProfit),'Before advertising cost'); }
      if (kind === 'ad-spend') { const spend=safeDivide(n('revenue'),n('target')); output=card('MAX AD SPEND',money(spend))+card('DAILY BUDGET',money(safeDivide(spend,n('days'))))+card('TARGET ROAS',`${number(n('target'),2)}x`); }
      if (kind === 'cac') { const total=n('marketing')+n('sales'), cac=safeDivide(total,n('customers')); output=card('CUSTOMER ACQUISITION COST',money(cac))+card('TOTAL ACQUISITION COST',money(total))+card('NEW CUSTOMERS',number(n('customers'),0)); }
      if (kind === 'ltv') { const revenue=n('aov')*n('frequency')*n('years'), gross=revenue*n('margin')/100; output=card('GROSS-PROFIT LTV',money(gross))+card('REVENUE LTV',money(revenue))+card('ANNUAL CUSTOMER VALUE',money(n('aov')*n('frequency'))); }
      if (kind === 'cpc') { const cpc=safeDivide(n('spend'),n('clicks')); output=card('AVERAGE CPC',money(cpc))+card('TOTAL SPEND',money(n('spend')))+card('CLICKS',number(n('clicks'),0)); }
      if (kind === 'cpm') { const cpm=safeDivide(n('spend'),n('impressions')/1000); output=card('CPM',money(cpm))+card('COST PER IMPRESSION',money(safeDivide(n('spend'),n('impressions'))))+card('IMPRESSIONS',number(n('impressions'),0)); }
      if (kind === 'cpa') { const cpa=safeDivide(n('spend'),n('conversions')); output=card('COST PER ACQUISITION',money(cpa))+card('TOTAL SPEND',money(n('spend')))+card('ACQUISITIONS',number(n('conversions'),0)); }
      if (kind === 'conversion-rate') { const rate=safeDivide(n('conversions'),n('visitors'))*100; output=card('CONVERSION RATE',`${number(rate,2)}%`)+card('CONVERSIONS',number(n('conversions'),0))+card('VISITORS PER CONVERSION',number(safeDivide(n('visitors'),n('conversions')),1)); }
      if (kind === 'profit-margin') { const gross=n('revenue')-n('cogs'), net=gross-n('expenses'); output=card('NET PROFIT MARGIN',`${number(safeDivide(net,n('revenue'))*100,2)}%`)+card('GROSS MARGIN',`${number(safeDivide(gross,n('revenue'))*100,2)}%`)+card('NET PROFIT',money(net)); }
      const result=root.querySelector<HTMLElement>('[data-general-result]')!, metrics=root.querySelector<HTMLElement>('[data-general-metrics]')!, error=root.querySelector<HTMLElement>('[data-general-error]')!;
      if (hasInvalid(output)) { error.textContent='Enter valid values in every field.'; error.classList.remove('hidden'); result.classList.add('hidden'); return; }
      error.classList.add('hidden'); metrics.innerHTML=output; result.classList.remove('hidden'); result.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth', block:'nearest' });
    });
    root.querySelectorAll('input[type="number"]').forEach((input) => {
      input.addEventListener('input', () => {
        const el = input as HTMLInputElement;
        if (el.validity.valid || el.value === '') { el.style.borderColor = ''; } else { el.style.borderColor = '#dc2626'; }
      });
    });
  });
</script>
