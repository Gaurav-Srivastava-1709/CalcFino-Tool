  calories: [...commonBody, { key: 'activity', label: 'Activity level', value: '1.55', options: [['1.2', 'BMR - Sedentary (little/no exercise)'], ['1.375', 'Light (1-3 times/week)'], ['1.55', 'Moderate (4-5 times/week)'], ['1.725', 'Active (daily exercise)'], ['1.9', 'Very Active (intense 6-7/week)'], ['2.05', 'Extra Active (very intense daily)'], ['2.3', 'Athlete (physical job + training)']] }, { key: 'bodyFat', label: 'Body fat % (for Katch-McArdle)', value: 20, min: 3, max: 60, step: 0.1 }, { key: 'formula', label: 'BMR Formula', value: 'mifflin', options: [['mifflin', 'Mifflin-St Jeor'], ['harris', 'Revised Harris-Benedict'], ['katch', 'Katch-McArdle (needs body fat %)']] }],
  'body-fat': [...commonBody, { key: 'age', label: 'Age', value: 30, min: 14 }, { key: 'neck', label: 'Neck (cm)', value: 38, min: 1, step: .1 }, { key: 'waist', label: 'Waist (cm)', value: 85, min: 1, step: .1 }, { key: 'hip', label: 'Hip (cm, women)', value: 95, min: 1, step: .1 }],
  'ideal-weight': commonBody.filter((field) => ['sex', 'height'].includes(field.key)),
  'lean-mass': commonBody.filter((field) => ['sex', 'weight', 'height'].includes(field.key)),
  'one-rep-max': [{ key: 'weight', label: 'Weight lifted', value: 80, min: 1, step: .5 }, { key: 'reps', label: 'Repetitions', value: 5, min: 1, max: 15 }],
  'heart-rate': [{ key: 'age', label: 'Age', value: 30, min: 14 }, { key: 'resting', label: 'Resting heart rate', value: 60, min: 30 }, { key: 'intensity', label: 'Target intensity (%)', value: 70, min: 40, max: 100 }],
  pregnancy: [{ key: 'method', label: 'Calculate based on', value: 'lmp', options: [['lmp', 'Last period'], ['duedate', 'Due date'], ['conception', 'Conception date'], ['ultrasound', 'Ultrasound date'], ['ivf', 'IVF transfer date']] }, { key: 'date', label: 'Date', value: '2026-08-01', type: 'date' }, { key: 'cycle', label: 'Cycle length (days)', value: 28, min: 20, max: 45 }, { key: 'usWeeks', label: 'Pregnancy at ultrasound (weeks)', value: 8, min: 4, max: 40 }, { key: 'usDays', label: 'Days', value: 0, min: 0, max: 6 }, { key: 'embryoAge', label: 'Embryo age', value: '5', options: [['3', 'Day 3'], ['5', 'Day 5'], ['6', 'Day 6']] }],
  cycle: [{ key: 'date', label: 'First day of last period', value: '2026-08-01', type: 'date' }, { key: 'cycle', label: 'Average cycle length (days)', value: 28, min: 20, max: 45 }, { key: 'period', label: 'Period length (days)', value: 5, min: 1, max: 10 }],
  macros: [...commonBody, { key: 'activity', label: 'Activity level', value: '1.55', options: [['1.2', 'BMR - Sedentary (little/no exercise)'], ['1.375', 'Light (1-3 times/week)'], ['1.55', 'Moderate (4-5 times/week)'], ['1.725', 'Active (daily exercise)'], ['1.9', 'Very Active (intense 6-7/week)'], ['2.05', 'Extra Active (very intense daily)'], ['2.3', 'Athlete (physical job + training)']] }, { key: 'goal', label: 'Your Goal', value: 'maintain', options: [['lose-mild', 'Mild weight loss (0.25 kg/week)'], ['lose', 'Weight loss (0.5 kg/week)'], ['lose-extreme', 'Extreme weight loss (1 kg/week)'], ['maintain', 'Maintain weight'], ['gain-mild', 'Mild weight gain (0.25 kg/week)'], ['gain', 'Weight gain (0.5 kg/week)'], ['gain-extreme', 'Extreme weight gain (1 kg/week)']] }, { key: 'bodyFat', label: 'Body fat % (for Katch-McArdle)', value: 20, min: 3, max: 60, step: 0.1 }],
  protein: [{ key: 'weight', label: 'Weight (kg)', value: 70, min: 1, step: .1 }, { key: 'activity', label: 'Activity level', value: '1.2', options: [['0.8', 'Sedentary (0.8 g/kg)'], ['1.0', 'Light activity (1.0 g/kg)'], ['1.2', 'Moderate exercise (1.2 g/kg)'], ['1.4', 'Active (1.4 g/kg)'], ['1.6', 'Very active (1.6 g/kg)'], ['1.8', 'Athlete (1.8 g/kg)'], ['2.2', 'Intense training (2.2 g/kg)']] }],
  'calories-burned': [{ key: 'weight', label: 'Weight (kg)', value: 70, min: 1 }, { key: 'minutes', label: 'Duration (minutes)', value: 30, min: 1 }, { key: 'met', label: 'Activity', value: '8', options: [['1', 'Sitting quietly'], ['1.5', 'Standing relaxed'], ['2', 'Light housework'], ['2.5', 'Walking (2 mph)'], ['3', 'Walking (3 mph)'], ['3.5', 'Walking (3.5 mph)'], ['4', 'Dancing / Yoga'], ['5', 'Walking (4 mph) / Cycling leisure'], ['6', 'Hiking / Light swimming'], ['7', 'Cycling (12-14 mph)'], ['8', 'Jogging / Swimming laps'], ['9.8', 'Running (6 mph)'], ['11', 'Running (7 mph)'], ['12.5', 'Running (8 mph)'], ['15', 'Running (10 mph)']] }],
  bsa: [{ key: 'weight', label: 'Weight (kg)', value: 70, min: 1 }, { key: 'height', label: 'Height (cm)', value: 175, min: 1 }],
  bac: [{ key: 'sex', label: 'Sex', value: 'male', options: [['male', 'Male'], ['female', 'Female']] }, { key: 'weight', label: 'Weight (kg)', value: 70, min: 1 }, { key: 'drinks', label: 'Standard drinks', value: 2, min: 0, step: 1 }, { key: 'hours', label: 'Hours since first drink', value: 2, min: 0, step: .5 }],
  gfr: [{ key: 'age', label: 'Age', value: 45, min: 18 }, { key: 'sex', label: 'Sex', value: 'male', options: [['male', 'Male'], ['female', 'Female']] }, { key: 'creatinine', label: 'Serum creatinine (mg/dL)', value: 1, min: .1, step: .01 }],
  'pregnancy-weight': [{ key: 'height', label: 'Height (cm)', value: 165, min: 100 }, { key: 'preweight', label: 'Pre-pregnancy weight (kg)', value: 60, min: 30, step: .1 }, { key: 'current', label: 'Current weight (kg)', value: 68, min: 30, step: .1 }, { key: 'week', label: 'Pregnancy week', value: 24, min: 1, max: 42 }, { key: 'twins', label: 'Pregnancy type', value: 'singleton', options: [['singleton', 'Singleton'], ['twins', 'Twins']] }],
  'body-type': [{ key: 'bust', label: 'Bust (cm)', value: 92, min: 1, step: .1 }, { key: 'waist', label: 'Waist (cm)', value: 72, min: 1, step: .1 }, { key: 'hip', label: 'Hip (cm)', value: 98, min: 1, step: .1 }],
  roas: [{ key: 'spend', label: 'Ad spend', value: 5000, min: 0, step: .01 }, { key: 'revenue', label: 'Revenue attributed to ads', value: 20000, min: 0, step: .01 }],
  'break-even-roas': [{ key: 'margin', label: 'Gross margin (%)', value: 40, min: .01, max: 100, step: .01 }, { key: 'aov', label: 'Average order value', value: 100, min: 0, step: .01 }],
  'ad-spend': [{ key: 'revenue', label: 'Target revenue', value: 50000, min: 0, step: .01 }, { key: 'target', label: 'Target ROAS', value: 4, min: .01, step: .01 }, { key: 'days', label: 'Campaign length (days)', value: 30, min: 1 }],
  cac: [{ key: 'marketing', label: 'Marketing costs', value: 10000, min: 0, step: .01 }, { key: 'sales', label: 'Sales costs', value: 5000, min: 0, step: .01 }, { key: 'customers', label: 'New customers acquired', value: 150, min: 1 }],
  ltv: [{ key: 'aov', label: 'Average order value', value: 75, min: 0, step: .01 }, { key: 'frequency', label: 'Purchases per year', value: 4, min: 0, step: .1 }, { key: 'years', label: 'Customer lifespan (years)', value: 3, min: 0, step: .1 }, { key: 'margin', label: 'Gross margin (%)', value: 50, min: 0, max: 100, step: .1 }],
  cpc: [{ key: 'spend', label: 'Total ad spend', value: 2500, min: 0, step: .01 }, { key: 'clicks', label: 'Total clicks', value: 1250, min: 1 }],
  cpm: [{ key: 'spend', label: 'Total ad spend', value: 2500, min: 0, step: .01 }, { key: 'impressions', label: 'Total impressions', value: 500000, min: 1 }],
  cpa: [{ key: 'spend', label: 'Total ad spend', value: 5000, min: 0, step: .01 }, { key: 'conversions', label: 'Acquisitions / conversions', value: 200, min: 1 }],
  'conversion-rate': [{ key: 'conversions', label: 'Conversions', value: 250, min: 0 }, { key: 'visitors', label: 'Visitors / clicks', value: 10000, min: 1 }],
  'profit-margin': [{ key: 'revenue', label: 'Revenue', value: 50000, min: 0, step: .01 }, { key: 'cogs', label: 'Cost of goods sold', value: 25000, min: 0, step: .01 }, { key: 'expenses', label: 'Other operating expenses', value: 10000, min: 0, step: .01 }],
};
const fields: Field[] = tool.name === 'Army Body Fat Calculator'
  ? [commonBody[0], commonBody[1], commonBody[2], commonBody[3], { key: 'neck', label: 'Neck (cm)', value: 38, min: 1, step: .1 }, { key: 'waist', label: 'Waist (cm)', value: 85, min: 1, step: .1 }, { key: 'hip', label: 'Hip (cm, women only)', value: 95, min: 1, step: .1 }]
  : tool.name === 'Body Fat Calculator'
    ? [commonBody[1], commonBody[2], commonBody[3], { key: 'neck', label: 'Neck (cm)', value: 38, min: 1, step: .1 }, { key: 'waist', label: 'Waist (cm)', value: 85, min: 1, step: .1 }, { key: 'hip', label: 'Hip (cm, women only)', value: 95, min: 1, step: .1 }]
    : tool.name === 'BMI Calculator' || tool.name === 'Healthy Weight Calculator'
      ? [commonBody[0], commonBody[1], commonBody[2], commonBody[3], { key: 'ethnicity', label: 'Ethnicity', value: 'european', options: [['european', 'White / European'], ['asian', 'Asian / South Asian'], ['african', 'Black / African'], ['hispanic', 'Hispanic / Latino'], ['other', 'Other']] }]
      : tool.name === 'Ideal Weight Calculator'
        ? [commonBody[1], commonBody[3], { key: 'frame', label: 'Frame size', value: 'medium', options: [['small', 'Small'], ['medium', 'Medium'], ['large', 'Large']] }]
        : tool.name === 'Commission Calculator'
          ? [{ key: 'income', label: 'Sales amount', value: 50000, min: 0 }, { key: 'deductions', label: 'Base pay', value: 0, min: 0 }, { key: 'rate', label: 'Commission rate (%)', value: 5, min: 0, step: .01 }]
          : schemas[tool.kind];
const financial = tool.category === 'Financial';
const marketing = tool.category === 'Marketing';
---
<section class="panel overflow-hidden" data-general-calculator data-kind={tool.kind} data-name={tool.name}>
  <div class="border-b bg-[var(--soft)] px-5 py-4 sm:px-6" style="border-color:var(--line)">
    <div class="flex items-center gap-3"><span class="grid size-9 place-items-center rounded-xl bg-[var(--panel)] text-[var(--color-primary)] shadow-sm"><svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M7 4v6M6 14h4M14 14h4M6 18h4M14 18h4"/></svg></span><div><h2 class="font-[var(--font-display)] font-bold tracking-[-.025em]">Calculate your result</h2><p class="mt-0.5 text-xs text-[var(--muted)]">Adjust the values to match your scenario.</p></div></div>
  </div>
  <form class="grid gap-4 p-5 sm:grid-cols-2 sm:p-6" data-general-form>
    {fields.map((field) => <div class="field">
      <label for={`${tool.slug}-${field.key}`}>{field.label}</label>
      {field.options ? <select class="control" id={`${tool.slug}-${field.key}`} name={field.key}>{field.options.map(([value, label]) => <option value={value} selected={value === field.value}>{label}</option>)}</select> : <input class="control" id={`${tool.slug}-${field.key}`} name={field.key} type={field.type ?? 'number'} value={field.value} min={field.min} max={field.max} step={field.step ?? 1} required />}
    </div>)}
    <p class="hidden rounded-lg bg-red-100 p-3 text-sm font-medium text-red-800 sm:col-span-2" data-general-error role="alert"></p>
    <button class="primary sm:col-span-2" type="submit">Calculate result</button>
  </form>
  <div class="hidden border-t bg-[var(--soft)] p-5 sm:p-6" style="border-color:var(--line)" data-general-result aria-live="polite">
    <p class="text-xs font-semibold tracking-[.08em] text-[var(--muted)]">ESTIMATED RESULT</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2" data-general-metrics></div>
    <p class="mt-4 text-xs leading-5 text-[var(--muted)]">{financial ? 'Planning estimate only. Rates, fees, taxes and product rules vary by provider and jurisdiction.' : marketing ? 'Performance estimate only. Use consistent attribution windows, currencies, channels, and revenue definitions when comparing campaigns.' : 'Educational estimate only. This result is not medical advice or a diagnosis.'}</p>
  </div>
</section>

<script>
  const money = (value: number) => new Intl.NumberFormat(undefined, { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(value);
  const currencyMoney = (value: number, code: string) => new Intl.NumberFormat(undefined, { style: 'currency', currency: code, maximumFractionDigits: 2 }).format(value);
  const number = (value: number, digits = 1) => new Intl.NumberFormat(undefined, { maximumFractionDigits: digits }).format(value);
  const card = (label: string, value: string, note: string | null = '', highlight: boolean | '' = false) => `<div class="result-metric${highlight ? ' result-highlight' : ''}"><div class="result-label">${label}</div><div class="result-value">${value}</div>${note ? `<div class="result-note">${note}</div>` : ''}</div>`;
  const safeDivide = (a: number, b: number, fallback = 0) => (!b || !Number.isFinite(b)) ? fallback : a / b;
  const hasInvalid = (html: string) => !html || /NaN|Infinity|undefined|null/.test(html);
  if (!document.getElementById('calc-dynamic-styles')) {
    const style = document.createElement('style');
    style.id = 'calc-dynamic-styles';
    style.textContent = `.amortization-wrap{margin-top:1.5rem}.amortization-details{border:1px solid var(--line);border-radius:0.75rem;overflow:hidden;background:var(--panel)}.amortization-toggle{display:flex;align-items:center;gap:0.5rem;padding:0.875rem 1rem;cursor:pointer;font-weight:600;font-size:0.875rem;color:var(--heading);list-style:none;user-select:none}.amortization-toggle:hover{background:var(--soft)}.amortization-toggle::-webkit-details-marker{display:none}.amortization-icon{display:grid;place-items:center;width:2rem;height:2rem;border-radius:0.5rem;background:rgba(79,70,229,0.08);color:#6366f1;flex-shrink:0}.amortization-count{margin-left:auto;font-size:0.75rem;font-weight:500;color:var(--muted);background:var(--soft);padding:0.2rem 0.6rem;border-radius:999px}.amortization-chevron{transition:transform 0.2s}details[open] .amortization-chevron{transform:rotate(180deg)}.amortization-table-wrap{overflow-x:auto;padding:0 1rem 1rem}.amortization-table{width:100%;border-collapse:collapse;font-size:0.8125rem}.amortization-table th{text-align:left;padding:0.625rem 0.75rem;font-weight:600;font-size:0.6875rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--muted);border-bottom:2px solid var(--line);white-space:nowrap;position:sticky;top:0;background:var(--panel)}.amortization-table td{padding:0.5rem 0.75rem;border-bottom:1px solid var(--line);white-space:nowrap;color:var(--body)}.amortization-table tbody tr:hover{background:var(--soft)}.donut-chart-wrap{margin-top:1.25rem}.donut-title{font-size:0.75rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:1rem}.donut-layout{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}.donut-container{flex-shrink:0}.donut-ring{width:140px;height:140px;border-radius:50%;position:relative;display:grid;place-items:center}.donut-hole{width:90px;height:90px;border-radius:50%;background:var(--panel);display:flex;flex-direction:column;align-items:center;justify-content:center;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}.donut-total-label{font-size:0.625rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted)}.donut-total-value{font-size:0.8125rem;font-weight:700;color:var(--heading);margin-top:0.125rem}.donut-legend{display:flex;flex-direction:column;gap:0.5rem;min-width:0}.donut-legend-item{display:flex;align-items:center;gap:0.5rem;font-size:0.8125rem}.donut-swatch{width:10px;height:10px;border-radius:3px;flex-shrink:0}.donut-legend-label{color:var(--body);white-space:nowrap}.donut-legend-value{margin-left:auto;font-weight:600;color:var(--heading);font-variant-numeric:tabular-nums}.donut-legend-pct{font-size:0.75rem;color:var(--muted);min-width:3rem;text-align:right}`;
    document.head.appendChild(style);
  }
  document.querySelectorAll<HTMLElement>('[data-general-calculator]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-general-form]')!;
    form.addEventListener('submit', (event) => {
      event.preventDefault(); const data = new FormData(form); const n = (key: string) => Number(data.get(key)); const s = (key: string) => String(data.get(key)); const kind = root.dataset.kind; const name = root.dataset.name!; let output = '';
      let amortData: { month: number; payment: number; principal: number; interest: number; balance: number; totalInterest: number }[] | undefined;
      let donutData: { label: string; value: number; color: string }[] | undefined;
      if (kind === 'mortgage') {
        const homePrice = n('homePrice');
        const downPct = n('downPayment') / 100;
        const downPayment = homePrice * downPct;
        const loanAmount = homePrice - downPayment;
        const r = n('rate') / 1200;
        const months = n('years') * 12;
        const basePI = r ? loanAmount * r * (1 + r) ** months / ((1 + r) ** months - 1) : loanAmount / months;
        const biweekly = s('biweekly') === 'biweekly';
        const piPayment = basePI;
         const extraMonthly = n('extra');
        const extraYearly = n('extraYearly');
        const extraOneTime = n('extraOneTime');
        const oneTimeMonth = n('oneTimeMonth');
        const biweeklyExtra = biweekly ? piPayment / 12 : 0;
        const taxIncrease = n('taxIncrease') / 100;
        const insIncrease = n('insuranceIncrease') / 100;
        const hoaIncrease = n('hoaIncrease') / 100;
        const otherIncrease = n('otherCostsIncrease') / 100;
        let balance = loanAmount;
        let totalPI = 0, totalTax = 0, totalIns = 0, totalPMI = 0, totalHOA = 0, totalOther = 0;
        const amortRows: { month: number; payment: number; principal: number; interest: number; balance: number; totalInterest: number }[] = [];
        let currentTax = (homePrice * n('propertyTax') / 100) / 12;
        let currentIns = n('homeInsurance') / 12;
        let currentHOA = n('hoa');
        let currentOther = n('otherCosts');
        let payoffMonth = months;
        for (let m = 1; m <= months && balance > 0; m++) {
          if (m > 1 && (m - 1) % 12 === 0) {
            currentTax *= (1 + taxIncrease);
            currentIns *= (1 + insIncrease);
            currentHOA *= (1 + hoaIncrease);
            currentOther *= (1 + otherIncrease);
          }
          const interest = balance * r;
          let princ = piPayment - interest;
          let extra = extraMonthly + biweeklyExtra;
          if (extraYearly > 0 && m % 12 === 0) extra += extraYearly;
          if (extraOneTime > 0 && m === oneTimeMonth) extra += extraOneTime;
          princ += extra;
          if (princ > balance) princ = balance;
          balance -= princ;
          totalPI += piPayment + extra;
          totalTax += currentTax;
          totalIns += currentIns;
          const pmiVal = downPct < 0.2 && balance > 0 ? n('pmi') : 0;
          totalPMI += pmiVal;
          totalHOA += currentHOA;
          totalOther += currentOther;
          amortRows.push({ month: m, payment: piPayment + extra + currentTax + currentIns + pmiVal + currentHOA + currentOther, principal: princ, interest, balance: Math.max(0, balance), totalInterest: totalPI - (loanAmount - Math.max(0, balance)) });
          if (balance <= 0) { payoffMonth = m; break; }
        }
        const totalMonthly = (piPayment + biweeklyExtra) + extraMonthly + (homePrice * n('propertyTax') / 100) / 12 + n('homeInsurance') / 12 + (downPct < 0.2 ? n('pmi') : 0) + n('hoa') + n('otherCosts');
        const totalInterest = totalPI - loanAmount;
        const startMonth = document.querySelector<HTMLInputElement>('[name="startDate"]')?.value || '2026-08';
        const [startYear, startMon] = startMonth.split('-').map(Number);
        const payoffDate = new Date(startYear, startMon - 1 + payoffMonth);
        const payoffLabel = payoffDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
        const totalCost = totalPI + totalTax + totalIns + totalPMI + totalHOA + totalOther;
        const monthlyPI = biweekly ? piPayment * 13 / 12 : piPayment;
        output = card('MONTHLY PAYMENT', money(biweekly ? piPayment * 13 / 12 : piPayment), biweekly ? 'Biweekly equivalent (P&I)' : 'Principal & interest', true)
          + card('MONTHLY TAX + INSURANCE', money((homePrice * n('propertyTax') / 100) / 12 + n('homeInsurance') / 12 + n('otherCosts') + (downPct < 0.2 ? n('pmi') : 0) + n('hoa')))
          + card('TOTAL OUT-OF-POCKET', money(totalMonthly), 'P&I + tax, insurance & costs')
          + card('PRINCIPAL & INTEREST', money(monthlyPI), 'Monthly (P&I)')
          + card('PROPERTY TAX', money((homePrice * n('propertyTax') / 100) / 12), 'Monthly (year 1)')
          + card('HOME INSURANCE', money(n('homeInsurance') / 12), 'Monthly (year 1)')
          + (downPct < 0.2 && n('pmi') > 0 ? card('PMI INSURANCE', money(n('pmi')), 'Until 20% equity') : '')
          + (n('hoa') > 0 ? card('HOA FEE', money(n('hoa'))) : '')
          + (n('otherCosts') > 0 ? card('OTHER COSTS', money(n('otherCosts'))) : '')
          + card('TOTAL INTEREST', money(totalInterest))
          + card('TOTAL COST', money(totalCost), 'All payments over loan life')
          + card('PAYOFF DATE', payoffLabel, `${payoffMonth} payments`)
          + card('HOME PRICE', money(homePrice))
          + card('DOWN PAYMENT', money(downPayment), `${(downPct * 100).toFixed(1)}%`)
          + card('LOAN AMOUNT', money(loanAmount));
        amortData = amortRows;
        donutData = [
          { label: 'Principal', value: loanAmount, color: '#6366f1' },
          { label: 'Interest', value: Math.max(0, totalInterest), color: '#f59e0b' },
          { label: 'Property Tax', value: totalTax, color: '#10b981' },
          { label: 'Insurance', value: totalIns, color: '#3b82f6' },
          { label: 'PMI', value: totalPMI, color: '#ef4444' },
          { label: 'HOA & Other', value: totalHOA + totalOther, color: '#8b5cf6' },
        ];
      }
      if (kind === 'amortization') {
        const p = n('principal'), r = n('rate') / 1200, maxMonths = n('years') * 12 + n('months');
        const basePayment = r ? p * r * (1 + r) ** maxMonths / ((1 + r) ** maxMonths - 1) : p / maxMonths;
        const extraM = n('extra'), extraY = n('extraYearly'), extraOT = n('extraOneTime'), otMonth = n('oneTimeMonth');
        const startVal = s('startDate') || '2026-08';
        const startParts = startVal.split('-').map(Number);
        const startDate = new Date(startParts[0], startParts[1] - 1, 1);
        const amortRows: { month: number; payment: number; principal: number; interest: number; balance: number; totalInterest: number }[] = [];
        let bal = p, cumInt = 0, totalPaid = 0, payoffMonth = maxMonths;
        for (let m = 1; m <= maxMonths && bal > 0; m++) {
          const int = bal * r;
          let extra = extraM;
          if (m % 12 === 0) extra += extraY;
          if (m === otMonth) extra += extraOT;
          const princ = Math.min(basePayment + extra - int, bal);
          if (princ < 0) { amortRows.push({ month: m, payment: basePayment, principal: 0, interest: int, balance: bal, totalInterest: cumInt + int }); cumInt += int; totalPaid += basePayment; continue; }
          bal = Math.max(0, bal - princ);
          cumInt += int;
          totalPaid += basePayment + extra;
          amortRows.push({ month: m, payment: basePayment + extra, principal: princ, interest: int, balance: bal, totalInterest: cumInt });
          if (bal <= 0) { payoffMonth = m; break; }
        }
        const interest = cumInt;
