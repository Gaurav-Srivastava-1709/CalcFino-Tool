---
import { tools } from '../data/tools';
import { categorySlug, generalTools } from '../data/calculatorCatalog';
const path = Astro.url.pathname;
const featured = tools.filter((tool) => ['pace-calculator', '5k-pace-calculator', 'marathon-pace-calculator', 'training-pace-calculator', 'treadmill-pace-calculator', 'finish-time-calculator'].includes(tool.slug));
const isCalculator = tools.some((tool) => path === `/${tool.slug}/` || path === `/${tool.slug}`) || path.startsWith('/financial/') || path.startsWith('/health/') || path.startsWith('/marketing/') || path.endsWith('-calculators/');
const searchItems = [
  ...tools.map((tool) => ({ name: tool.name, url: `/${tool.slug}` })),
  ...generalTools.map((tool) => ({ name: tool.name, url: `/${categorySlug(tool)}/${tool.slug}` })),
];
---
<header class="sticky top-0 z-30 border-b bg-[color:var(--panel)]/95 backdrop-blur-md" style="border-color:var(--line)">
  <div class="shell flex h-[4.5rem] items-center justify-between gap-5">
    <a href="/" class="flex shrink-0 items-center gap-2.5 font-bold tracking-[-.02em]" aria-label="CalcFino Tools home">
      <span class="grid size-9 place-items-center rounded-xl bg-[var(--color-primary)] text-white shadow-sm shadow-emerald-600/20" aria-hidden="true"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2"/></svg></span>
      <span class="font-[var(--font-display)] text-[1.02rem] font-bold tracking-[-.025em]">CalcFino <span class="font-medium text-[var(--muted)]">Tools</span></span>
    </a>

    <nav aria-label="Main navigation" class="hidden h-full items-center gap-1 md:flex">
      <details class="nav-dropdown group relative h-full">
        <summary class:list={['flex h-full cursor-pointer list-none items-center gap-1.5 px-3 text-sm font-medium transition-colors hover:text-[var(--color-primary)]', isCalculator && 'text-[var(--color-primary)]']}>
          Calculators
          <svg class="size-3.5 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
        </summary>
        <div class="absolute left-0 top-full w-[38rem] rounded-2xl border bg-[var(--panel)] p-2.5 shadow-2xl shadow-slate-900/10 dark:shadow-black/30" style="border-color:var(--line)">
          <div class="grid grid-cols-3 gap-2 p-1">
            <a href="/financial-calculators" class="rounded-lg bg-[var(--soft)] p-3 transition hover:text-[var(--color-primary)]"><span class="block text-sm font-semibold">Financial calculators</span><span class="mt-1 block text-xs text-[var(--muted)]">71 tools</span></a>
            <a href="/health-calculators" class="rounded-lg bg-[var(--soft)] p-3 transition hover:text-[var(--color-primary)]"><span class="block text-sm font-semibold">Health & fitness</span><span class="mt-1 block text-xs text-[var(--muted)]">27 tools</span></a>
            <a href="/marketing-calculators" class="rounded-lg bg-[var(--soft)] p-3 transition hover:text-[var(--color-primary)]"><span class="block text-sm font-semibold">Marketing</span><span class="mt-1 block text-xs text-[var(--muted)]">10 tools</span></a>
          </div>
          <p class="px-4 pb-1 pt-3 text-xs font-semibold uppercase tracking-[.06em] text-[var(--muted)]">Popular running tools</p>
          <div class="grid grid-cols-2 gap-1">
            {featured.map((tool) => (
              <a href={`/${tool.slug}`} class="group/item rounded-lg p-3 transition-colors hover:bg-[var(--soft)]">
                <span class="block text-sm font-semibold group-hover/item:text-[var(--color-primary)]">{tool.shortName}</span>
                <span class="mt-1 block truncate text-xs text-[var(--muted)]">{tool.category}</span>
              </a>
            ))}
          </div>
          <a href="/#tools" class="mt-1 flex items-center justify-between rounded-lg border-t px-3 py-3 text-sm font-semibold text-[var(--color-primary)]" style="border-color:var(--line)">
            View all 19 calculators <span aria-hidden="true">-&gt;</span>
          </a>
        </div>
      </details>
      <a class:list={['rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-[var(--soft)] hover:text-[var(--color-primary)]', path === '/about/' && 'text-[var(--color-primary)]']} href="/about">About</a>
      <a class:list={['rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-[var(--soft)] hover:text-[var(--color-primary)]', path === '/contact/' && 'text-[var(--color-primary)]']} href="/contact">Contact</a>
      <a class:list={['rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-[var(--soft)] hover:text-[var(--color-primary)]', path === '/privacy-policy/' && 'text-[var(--color-primary)]']} href="/privacy-policy">Privacy</a>
    </nav>

    <div class="flex items-center gap-2">
      <div class="relative hidden lg:block group" id="desktop-search-container">
        <label class="sr-only" for="header-search">Search calculators</label>
        <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-[var(--muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input id="header-search" class="h-10 w-64 rounded-xl border bg-[var(--panel)] pl-9 pr-3 text-sm outline-none transition focus:border-[var(--color-primary)] focus:ring-3 focus:ring-emerald-500/10" style="border-color:var(--line)" type="search" placeholder="Search calculators..." autocomplete="off" />
        
        <div id="search-dropdown" class="absolute left-0 top-full mt-2 hidden w-full overflow-hidden rounded-xl border bg-[var(--panel)] py-2 shadow-xl shadow-slate-900/5 dark:shadow-black/40" style="border-color:var(--line)">
          <ul id="search-list" class="max-h-64 overflow-y-auto px-1.5" style="scrollbar-width: thin; scrollbar-color: var(--line) transparent;">
            {searchItems.map((item) => (
              <li class="search-item" data-name={item.name.toLowerCase()}>
                <a href={item.url} class="block rounded-lg px-3 py-2 text-sm font-medium text-[var(--text)] hover:bg-[var(--soft)] hover:text-[var(--color-primary)] transition-colors">
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
          <p id="search-empty" class="hidden px-4 py-3 text-sm text-[var(--muted)]">No calculators found.</p>
        </div>
      </div>
      
      <button id="theme-toggle" class="grid size-10 cursor-pointer place-items-center rounded-xl border bg-[var(--panel)] transition-colors hover:bg-[var(--soft)]" style="border-color:var(--line)" aria-label="Switch color theme" title="Switch color theme">
        <svg class="size-4 text-[var(--muted)] dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg class="hidden size-4 text-[var(--muted)] dark:inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
      </button>
      <button id="mobile-menu-toggle" class="grid size-9 cursor-pointer place-items-center rounded-lg border bg-[var(--panel)] transition-colors hover:bg-[var(--soft)] md:hidden" style="border-color:var(--line)" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile navigation" class="hidden border-t bg-[var(--panel)] md:hidden" style="border-color:var(--line)">
    <div class="shell py-4">
      <p class="px-2 pb-2 text-xs font-semibold uppercase tracking-[.06em] text-[var(--muted)]">Popular calculators</p>
      <div class="mb-3"><label class="sr-only" for="mobile-search">Search calculators</label><input id="mobile-search" class="control" type="search" placeholder="Search all calculators..." autocomplete="off" /></div>
      <div class="mb-3 grid grid-cols-2 gap-2"><a href="/financial-calculators" class="rounded-lg bg-[var(--soft)] p-3 text-sm font-semibold">Financial <span class="block pt-1 text-xs font-normal text-[var(--muted)]">71 tools</span></a><a href="/health-calculators" class="rounded-lg bg-[var(--soft)] p-3 text-sm font-semibold">Health <span class="block pt-1 text-xs font-normal text-[var(--muted)]">27 tools</span></a><a href="/marketing-calculators" class="col-span-2 rounded-lg bg-[var(--soft)] p-3 text-sm font-semibold">Marketing & revenue <span class="block pt-1 text-xs font-normal text-[var(--muted)]">10 tools</span></a></div>
      <div class="grid grid-cols-2 gap-1">
        {featured.slice(0, 4).map((tool) => <a href={`/${tool.slug}`} class="rounded-lg px-2 py-2.5 text-sm font-medium hover:bg-[var(--soft)]">{tool.shortName}</a>)}
      </div>
      <a href="/#tools" class="mt-2 block rounded-lg bg-[var(--soft)] px-3 py-2.5 text-sm font-semibold text-[var(--color-primary)]">View all calculators</a>
      <div class="mt-3 flex gap-2 border-t pt-3" style="border-color:var(--line)">
        <a href="/about" class="flex-1 rounded-lg px-3 py-2 text-center text-sm font-medium hover:bg-[var(--soft)]">About</a>
        <a href="/contact" class="flex-1 rounded-lg px-3 py-2 text-center text-sm font-medium hover:bg-[var(--soft)]">Contact</a>
        <a href="/privacy-policy" class="flex-1 rounded-lg px-3 py-2 text-center text-sm font-medium hover:bg-[var(--soft)]">Privacy</a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const root = document.documentElement;
  const saved = localStorage.getItem('theme');
  if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) root.classList.add('dark');
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    root.classList.toggle('dark');
    localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
  });

  const menuButton = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  menuButton?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
  });

  document.querySelectorAll('.nav-dropdown').forEach((dropdown) => {
    dropdown.addEventListener('toggle', () => {
      if (!(dropdown instanceof HTMLDetailsElement) || !dropdown.open) return;
      document.querySelectorAll('.nav-dropdown').forEach((other) => { if (other !== dropdown && other instanceof HTMLDetailsElement) other.open = false; });
    });
  });
  
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.nav-dropdown[open]').forEach((dropdown) => {
      if (event.target instanceof Node && !dropdown.contains(event.target) && dropdown instanceof HTMLDetailsElement) dropdown.open = false;
    });
  });
  
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') document.querySelectorAll('.nav-dropdown[open]').forEach((dropdown) => { if (dropdown instanceof HTMLDetailsElement) dropdown.open = false; });
  });

  // Custom Search Dropdown Logic
  const searchInput = document.getElementById('header-search');
  const searchDropdown = document.getElementById('search-dropdown');
  const searchItems = document.querySelectorAll('.search-item');
  const searchEmpty = document.getElementById('search-empty');
  
  if (searchInput && searchDropdown) {
    searchInput.addEventListener('focus', () => searchDropdown.classList.remove('hidden'));
    
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
        searchDropdown.classList.add('hidden');
      }
    });

    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase().trim();
      let hasVisible = false;
      
      searchItems.forEach(item => {
        const match = item.dataset.name.includes(term);
        item.style.display = match ? 'block' : 'none';
        if (match) hasVisible = true;
      });
      
      searchEmpty.classList.toggle('hidden', hasVisible);
    });
  }
</script>
