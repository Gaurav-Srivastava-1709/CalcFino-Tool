---
import Layout from '../layouts/Layout.astro';
import GeneralToolCard from '../components/GeneralToolCard.astro';
import { marketingGroups, marketingTools } from '../data/calculatorCatalog';
const groupDescriptions: Record<string, string> = {
  'Advertising returns': 'Connect attributed revenue, ad spend, gross margin and campaign targets to evaluate ROAS and budget scenarios.',
  'Customer economics': 'Compare the cost to acquire a customer with estimated lifetime revenue and gross profit using aligned customer cohorts and periods.',
  'Campaign costs': 'Standardize media cost by click, thousand impressions or acquisition before comparing channels with different buying models.',
  'Conversion & profit': 'Measure funnel conversion and the gross or net margin behind revenue so efficiency metrics have business context.',
};
const pageUrl = new URL('/marketing-calculators/', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': new URL('/', Astro.site).href },
        { '@type': 'ListItem', 'position': 2, 'name': 'Free Marketing Calculators', 'item': pageUrl },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': pageUrl,
      'name': 'Free Marketing Calculators',
      'url': pageUrl,
      'description': 'Marketing calculators for advertising returns, acquisition economics, campaign costs, conversion and profit.',
      'mainEntity': {
        '@type': 'ItemList',
        'numberOfItems': marketingTools.length,
        'itemListElement': marketingTools.map((tool, index) => ({
          '@type': 'ListItem',
          'position': index + 1,
          'name': tool.name,
          'url': new URL(`/marketing/${tool.slug}/`, Astro.site).href,
        })),
      },
    },
  ],
};
---
<Layout title="Free Marketing Calculators" description="Free ROAS, ad spend, CAC, LTV, CPC, CPM, CPA, conversion rate and profit margin calculators for marketers.">
  <section class="shell py-14 sm:py-20">
    <div class="mb-6 text-sm text-[var(--muted)]"><a href="/">Home</a><span class="mx-2">/</span>Marketing calculators</div>
    <p class="eyebrow">10 campaign and revenue tools</p><h1 class="display mt-4 max-w-3xl text-4xl sm:text-5xl">Free Marketing Calculators</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">Start with the question you need to answer. Use the <a class="font-medium text-[var(--color-primary)]" href="/marketing/roas-calculator/">ROAS calculator</a> to review attributed revenue efficiency, the <a class="font-medium text-[var(--color-primary)]" href="/marketing/break-even-roas-calculator/">break-even ROAS calculator</a> to include gross margin, or compare <a class="font-medium text-[var(--color-primary)]" href="/marketing/cac-calculator/">CAC</a> with <a class="font-medium text-[var(--color-primary)]" href="/marketing/ltv-calculator/">customer lifetime value</a> for acquisition planning.</p>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--muted)]">Keep reporting periods, currencies, attribution windows and conversion definitions aligned. A platform metric alone does not establish incrementality or profit.</p>
    <label class="panel mt-8 block max-w-xl p-1.5"><span class="sr-only">Search marketing calculators</span><input class="control border-0 shadow-none" type="search" placeholder="Search ROAS, CAC, CPC, margin..." data-catalog-search /></label>
  </section>
  <section class="shell border-t pb-20 pt-10" style="border-color:var(--line)" data-catalog>
    {marketingGroups.map((group) => <div class="catalog-group mb-12"><h2 class="text-lg font-semibold">{group}</h2><p class="mb-4 mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">{groupDescriptions[group]}</p><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{marketingTools.filter((tool) => tool.group === group).map((tool) => <GeneralToolCard tool={tool} />)}</div></div>)}
    <p class="hidden rounded-xl border bg-[var(--panel)] p-6 text-center text-sm text-[var(--muted)]" data-empty>No matching calculator found.</p>
    <div class="prose-copy mx-auto mt-16 max-w-3xl border-t pt-12" style="border-color:var(--line)"><h2>How to use marketing metrics responsibly</h2><p>Advertising metrics are most useful when definitions stay consistent. Use spend, revenue, clicks, impressions, customers and conversions from the same reporting period. Check whether your platform reports click-through, view-through or modeled conversions, and use the same attribution window when comparing campaigns.</p><p>ROAS measures attributed revenue efficiency, while CAC and CPA measure acquisition cost. CPC and CPM describe media delivery. Conversion rate describes funnel behavior. LTV and profit margin add business context. No single metric proves incrementality or profitability, so review the connected measures together before increasing a budget.</p></div>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
<script>const input=document.querySelector<HTMLInputElement>('[data-catalog-search]');const empty=document.querySelector<HTMLElement>('[data-empty]');input?.addEventListener('input',()=>{let visible=0;document.querySelectorAll<HTMLElement>('[data-catalog] a').forEach(card=>{const match=card.textContent?.toLowerCase().includes(input.value.trim().toLowerCase())??false;card.classList.toggle('hidden',!match);if(match)visible++});document.querySelectorAll<HTMLElement>('.catalog-group').forEach(group=>group.classList.toggle('hidden',!group.querySelector('a:not(.hidden)')));empty?.classList.toggle('hidden',visible>0)});</script>
