---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Server Error" description="CalcFino Tools encountered an unexpected error." noindex>
  <section class="shell py-28 text-center"><p class="eyebrow">500 error</p><h1 class="display mt-5 text-5xl sm:text-6xl">Something went wrong</h1><p class="mx-auto mt-5 max-w-md text-lg text-[var(--muted)]">The page could not be completed. Return to the calculator directory and try again.</p><a class="primary mt-8" href="/">View all calculators</a></section>
</Layout>
