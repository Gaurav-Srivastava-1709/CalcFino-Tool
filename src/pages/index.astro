---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
const categories = ['Core pace', 'Race day', 'Training', 'Specialized'] as const;
const siteUrl = new URL('/', Astro.site).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      'name': 'CalcFino Tools',
      'url': siteUrl,
      'inLanguage': 'en-US',
      'description': 'Free financial, health, fitness, marketing and running calculators with clear inputs and instant results.'
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      'name': 'CalcFino Tools',
      'url': siteUrl,
      'logo': new URL('/favicon.svg', Astro.site).href
    }
  ]
};
---
<Layout title="Free Online Calculators | CalcFino Tools" description="Free financial, health, fitness and running calculators with clear inputs, instant results and no signup.">
  <section class="shell py-16 text-center sm:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="mx-auto inline-flex items-center gap-2 rounded-full border bg-[var(--panel)] px-3.5 py-2 text-xs font-semibold text-[var(--muted)] shadow-sm" style="border-color:var(--line)"><span class="size-1.5 rounded-full bg-emerald-500"></span> 127 free online calculators</p>
      <h1 class="display mt-7 text-[clamp(2.75rem,7vw,4.75rem)]">Better numbers.<br/><span class="text-[var(--color-primary)]">Smarter decisions.</span></h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">Fast, easy-to-use calculators for money, marketing, health, fitness and running. Clear inputs, instant results and no signup.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3"><a class="inline-flex min-h-12 items-center justify-center rounded-lg border bg-[var(--panel)] px-5 text-sm font-semibold transition-colors hover:bg-[var(--color-primary)] hover:text-white" style="border-color:var(--line)" href="/financial-calculators">Financial calculators</a><a class="inline-flex min-h-12 items-center justify-center rounded-lg border bg-[var(--panel)] px-5 text-sm font-semibold transition-colors hover:bg-[var(--color-primary)] hover:text-white" style="border-color:var(--line)" href="/marketing-calculators">Marketing calculators</a><a class="inline-flex min-h-12 items-center justify-center rounded-lg border bg-[var(--panel)] px-5 text-sm font-semibold transition-colors hover:bg-[var(--color-primary)] hover:text-white" style="border-color:var(--line)" href="/health-calculators">Health calculators</a></div>
    </div>
  </section>

  <section class="shell pb-8" aria-labelledby="categories-title">
    <div class="mb-6 flex items-end justify-between gap-4"><div><p class="eyebrow">Browse by category</p><h2 id="categories-title" class="display mt-3 text-3xl">Find the right tool</h2></div><p class="hidden text-sm text-[var(--muted)] sm:block">No signup. Calculations stay in your browser.</p></div>
    <div class="grid gap-4 md:grid-cols-2">
      <a href="/financial-calculators" class="group panel flex min-h-52 flex-col p-6 hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-lg hover:shadow-emerald-900/5">
        <div class="flex items-start justify-between"><span class="grid size-11 place-items-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span><span class="rounded-full bg-[var(--soft)] px-2.5 py-1 text-xs font-semibold text-[var(--muted)]">71 tools</span></div>
        <h3 class="mt-5 font-[var(--font-display)] text-xl font-bold tracking-[-.03em]">Financial calculators</h3><p class="mt-2 text-sm leading-6 text-[var(--muted)]">Mortgage, loans, investing, retirement, taxes and business planning.</p><span class="mt-auto pt-5 text-sm font-semibold text-[var(--color-primary)]">Explore financial tools <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
      <a href="/marketing-calculators" class="group panel flex min-h-52 flex-col p-6 hover:-translate-y-0.5 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-900/5">
        <div class="flex items-start justify-between"><span class="grid size-11 place-items-center rounded-xl bg-violet-50 text-violet-600 dark:bg-violet-950/60 dark:text-violet-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14h4l3-8 4 13 2-5h3"/></svg></span><span class="rounded-full bg-[var(--soft)] px-2.5 py-1 text-xs font-semibold text-[var(--muted)]">10 tools</span></div>
        <h3 class="mt-5 font-[var(--font-display)] text-xl font-bold tracking-[-.03em]">Marketing & revenue</h3><p class="mt-2 text-sm leading-6 text-[var(--muted)]">ROAS, CAC, LTV, campaign costs, conversion rate and margins.</p><span class="mt-auto pt-5 text-sm font-semibold text-[var(--color-primary)]">Explore marketing tools <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
      <a href="/health-calculators" class="group panel flex min-h-52 flex-col p-6 hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-lg hover:shadow-emerald-900/5">
        <div class="flex items-start justify-between"><span class="grid size-11 place-items-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg></span><span class="rounded-full bg-[var(--soft)] px-2.5 py-1 text-xs font-semibold text-[var(--muted)]">27 tools</span></div>
        <h3 class="mt-5 font-[var(--font-display)] text-xl font-bold tracking-[-.03em]">Health & fitness</h3><p class="mt-2 text-sm leading-6 text-[var(--muted)]">BMI, calories, nutrition, heart rate, pregnancy and body metrics.</p><span class="mt-auto pt-5 text-sm font-semibold text-[var(--color-primary)]">Explore health tools <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
      <a href="#tools" class="group panel flex min-h-52 flex-col p-6 hover:-translate-y-0.5 hover:border-orange-300 hover:shadow-lg hover:shadow-orange-900/5">
        <div class="flex items-start justify-between"><span class="grid size-11 place-items-center rounded-xl bg-orange-50 text-orange-600 dark:bg-orange-950/60 dark:text-orange-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 4v6h6M11 20v-6H5M19 10a7 7 0 0 0-12-4M5 14a7 7 0 0 0 12 4"/></svg></span><span class="rounded-full bg-[var(--soft)] px-2.5 py-1 text-xs font-semibold text-[var(--muted)]">19 tools</span></div>
        <h3 class="mt-5 font-[var(--font-display)] text-xl font-bold tracking-[-.03em]">Running & pace</h3><p class="mt-2 text-sm leading-6 text-[var(--muted)]">Race pace, finish time, training zones, treadmill and swimming.</p><span class="mt-auto pt-5 text-sm font-semibold text-[var(--color-primary)]">Explore pace tools <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
    </div>
  </section>

  <section class="shell py-20 sm:py-24" id="tools">
    <div class="flex flex-wrap items-end justify-between gap-5 border-b pb-6" style="border-color:var(--line)">
      <div><p class="eyebrow">Running calculators</p><h2 class="display mt-3 text-3xl sm:text-4xl">Pace and training tools</h2></div>
      <p class="max-w-sm text-sm leading-6 text-[var(--muted)]">Every calculator works on mobile and desktop, keeps inputs on your device and explains how to interpret the result.</p>
    </div>
    {categories.map((category) => <div class="mt-12">
      <h3 class="mb-4 text-sm font-semibold text-[var(--text)]">{category}</h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{tools.filter((tool) => tool.category === category).map((tool) => <ToolCard tool={tool} index={tools.indexOf(tool)} />)}</div>
    </div>)}
  </section>

  <section class="shell border-t py-20" style="border-color:var(--line)">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">The basics</p><h2 class="display mt-3 text-3xl sm:text-4xl">What pace tells you</h2>
      <div class="prose-copy mt-8">
      <p><strong>Running pace is the time needed to cover a unit of distance.</strong> Runners commonly express it as minutes per kilometer or minutes per mile. Speed describes the same movement as distance per hour, but pace is often easier to use during a workout because watches, track markers and race signs are organized around splits.</p>
      <p>A useful pace calculator does more than divide time by distance. It should convert units correctly, preserve seconds, show the matching speed and create cumulative checkpoints. CalcFino performs those calculations locally in your browser. No training result is uploaded or attached to an account.</p>
      <h3>Use a recent, representative result</h3>
      <p>For race planning, begin with a performance completed under conditions similar to the event ahead. A flat road result may not translate directly to a trail race, and a cool-weather result can overstate what is sustainable in heat. Training pace estimates are starting ranges, not rigid pass-or-fail targets. Heart rate, perceived effort, terrain, sleep and weather still matter.</p>
      <h3>Why even splits are only a starting point</h3>
      <p>The split tables assume constant pace. This makes the arithmetic transparent and gives you a clean baseline. Real courses may call for steady effort rather than identical splits, especially over hills or into wind. Use the grade-adjusted calculator to compare hilly efforts, then make conservative adjustments instead of forcing an exact number on every section.</p>
      <h3>Financial calculators for scenario planning</h3>
      <p>The financial directory covers mortgages, amortization, auto and personal loans, savings, compound interest, retirement, salary, tax assumptions, budgeting, leases and business percentages. These tools are most useful when you compare scenarios instead of relying on one forecast. For example, calculate a loan at the advertised rate, then test a higher rate or an extra monthly payment. For an investment projection, compare conservative and optimistic returns while keeping contributions unchanged. CalcFino displays the assumptions next to the inputs and explains the formula on each calculator page.</p>
      <h3>Health and fitness estimates with context</h3>
      <p>Health tools include BMI, calorie needs, BMR, TDEE, body-fat methods, ideal and lean body mass, target heart rate, one-repetition maximum, pregnancy dates, cycle estimates, nutrition, body surface area, BAC and race-free CKD-EPI eGFR. Each result includes a method explanation and limitations because an equation is not the same as a diagnosis or direct measurement. Use consistent measurements, read the supporting values, and consult a qualified professional when a result affects health, pregnancy, medication, safety or treatment.</p>
      <h3>Marketing and revenue performance</h3>
      <p>The marketing directory connects media metrics with business economics. ROAS and break-even ROAS evaluate advertising revenue efficiency, while CPC, CPM and CPA standardize campaign cost. CAC includes broader sales and marketing costs, LTV estimates customer value, conversion rate describes funnel performance, and profit margin shows how much revenue remains after costs. Use matching attribution windows and reporting periods so comparisons remain meaningful.</p>
      <h3>How CalcFino protects clarity and privacy</h3>
      <p>All calculator inputs are processed in the browser. You do not need to create an account, and entered values are not saved as a personal profile. Pages are statically generated with Astro so the instructions, formulas and frequently asked questions are available in the original HTML for fast loading and search accessibility. Every tool links to related calculators, but each page also states its own assumptions so you can understand what is being estimated before using the number.</p>
      <h3>Choosing the right calculator</h3>
      <p>Start with the category directory or use the search field in the header. Choose the most specific tool for your question, verify units, and enter current values. If a calculator requires a rate, use a rate from an authoritative or current source rather than guessing. Financial rules, exchange rates, program limits and tax thresholds can change. Health equations describe groups and may not represent every individual. A transparent estimate is valuable when it helps you ask better questions, compare options and recognize which inputs matter most.</p>
      </div>
    </div>
  </section>

  <section class="shell border-t py-16" style="border-color:var(--line)">
    <div class="mb-6"><p class="eyebrow">Company & legal</p><h2 class="display mt-3 text-3xl">Learn more about CalcFino</h2></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/about" class="group panel flex flex-col p-6 hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-900/5">
        <span class="grid size-11 place-items-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg></span>
        <h3 class="mt-4 font-[var(--font-display)] text-lg font-bold tracking-[-.02em]">About Us</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Learn why CalcFino Tools was created, our approach to transparent calculations and privacy-first design.</p>
        <span class="mt-auto pt-4 text-sm font-semibold text-[var(--color-primary)]">Read more <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
      <a href="/contact" class="group panel flex flex-col p-6 hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-lg hover:shadow-emerald-900/5">
        <span class="grid size-11 place-items-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2Z"/><polyline points="22,6 12,13 2,6"/></svg></span>
        <h3 class="mt-4 font-[var(--font-display)] text-lg font-bold tracking-[-.02em]">Contact Us</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Report a bug, suggest a feature, ask a privacy question or explore partnership opportunities.</p>
        <span class="mt-auto pt-4 text-sm font-semibold text-[var(--color-primary)]">Get in touch <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
      <a href="/privacy-policy" class="group panel flex flex-col p-6 hover:-translate-y-0.5 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-900/5">
        <span class="grid size-11 place-items-center rounded-xl bg-violet-50 text-violet-600 dark:bg-violet-950/60 dark:text-violet-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg></span>
        <h3 class="mt-4 font-[var(--font-display)] text-lg font-bold tracking-[-.02em]">Privacy Policy</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Understand how CalcFino handles your data — calculations stay in your browser, no personal data is collected.</p>
        <span class="mt-auto pt-4 text-sm font-semibold text-[var(--color-primary)]">Read policy <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
      <a href="/terms" class="group panel flex flex-col p-6 hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-lg hover:shadow-amber-900/5">
        <span class="grid size-11 place-items-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-950/60 dark:text-amber-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span>
        <h3 class="mt-4 font-[var(--font-display)] text-lg font-bold tracking-[-.02em]">Terms of Use</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Review the terms governing use of CalcFino Tools and its free calculators.</p>
        <span class="mt-auto pt-4 text-sm font-semibold text-[var(--color-primary)]">Read terms <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
      <a href="/disclaimer" class="group panel flex flex-col p-6 hover:-translate-y-0.5 hover:border-rose-300 hover:shadow-lg hover:shadow-rose-900/5">
        <span class="grid size-11 place-items-center rounded-xl bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-300"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg></span>
        <h3 class="mt-4 font-[var(--font-display)] text-lg font-bold tracking-[-.02em]">Disclaimer</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Important disclaimers for financial, health and marketing calculator estimates.</p>
        <span class="mt-auto pt-4 text-sm font-semibold text-[var(--color-primary)]">Read disclaimer <span class="inline-block transition group-hover:translate-x-1">-&gt;</span></span>
      </a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</Layout>
