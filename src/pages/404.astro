---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found" description="The requested CalcFino Tools page could not be found." noindex>
  <section class="shell py-28 text-center"><p class="eyebrow">404 error</p><h1 class="display mt-5 text-5xl sm:text-6xl">Page not found</h1><p class="mx-auto mt-5 max-w-md text-lg text-[var(--muted)]">That page does not exist or has moved. Head back to the calculator directory.</p><a class="primary mt-8" href="/">View all calculators</a></section>
</Layout>
