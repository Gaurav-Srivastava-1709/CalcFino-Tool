---
import Layout from '../layouts/Layout.astro';
import GeneralToolCard from '../components/GeneralToolCard.astro';
import { healthGroups, healthTools } from '../data/calculatorCatalog';
---
<Layout title="Free Health & Fitness Calculators" description="Free health calculators for BMI, calories, body fat, nutrition, heart rate, pregnancy and fitness estimates.">
  <section class="shell py-14 sm:py-20">
    <p class="eyebrow">28 health & fitness calculators</p><h1 class="display mt-4 max-w-3xl text-4xl sm:text-5xl">Understand your health numbers.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">Use evidence-based formulas for fitness, nutrition and body measurements. Results are educational estimates, not diagnoses.</p>
    <label class="panel mt-8 block max-w-xl p-1.5"><span class="sr-only">Search health calculators</span><input class="control border-0 shadow-none" type="search" placeholder="Search BMI, calories, protein..." data-catalog-search /></label>
  </section>
  <section class="shell border-t pb-20 pt-10" style="border-color:var(--line)" data-catalog>
    <div class="catalog-group mb-12"><h2 class="mb-4 text-lg font-semibold">Running</h2><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><a href="/pace-calculator" class="group flex items-center justify-between gap-4 rounded-xl border bg-[var(--panel)] p-4 transition hover:border-[var(--color-primary)]" style="border-color:var(--line)"><div><h3 class="text-sm font-semibold">Pace Calculator</h3><p class="mt-1 text-xs text-[var(--muted)]">Running</p></div><span>-&gt;</span></a></div></div>
    {healthGroups.map((group) => <div class="catalog-group mb-12"><h2 class="mb-4 text-lg font-semibold">{group}</h2><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{healthTools.filter((tool) => tool.group === group).map((tool) => <GeneralToolCard tool={tool} />)}</div></div>)}
    <p class="hidden rounded-xl border bg-[var(--panel)] p-6 text-center text-sm text-[var(--muted)]" data-empty>No matching calculator found.</p>
  </section>
</Layout>
<script>const input=document.querySelector<HTMLInputElement>('[data-catalog-search]');const empty=document.querySelector<HTMLElement>('[data-empty]');input?.addEventListener('input',()=>{let visible=0;document.querySelectorAll<HTMLElement>('[data-catalog] a').forEach(card=>{const match=card.textContent?.toLowerCase().includes(input.value.trim().toLowerCase())??false;card.classList.toggle('hidden',!match);if(match)visible++});document.querySelectorAll<HTMLElement>('.catalog-group').forEach(group=>group.classList.toggle('hidden',!group.querySelector('a:not(.hidden)')));empty?.classList.toggle('hidden',visible>0)});</script>
