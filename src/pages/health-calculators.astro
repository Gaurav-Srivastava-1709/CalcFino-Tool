---
import Layout from '../layouts/Layout.astro';
import GeneralToolCard from '../components/GeneralToolCard.astro';
import { healthGroups, healthTools } from '../data/calculatorCatalog';
const groupDescriptions: Record<string, string> = {
  'Fitness': 'Estimate energy needs, body measurements, heart-rate targets and strength benchmarks using the method and inputs shown on each calculator.',
  'Pregnancy': 'Estimate dates and pregnancy weight ranges for planning, then rely on your care team for clinical dating and individualized guidance.',
  'Nutrition': 'Explore calorie and macronutrient targets, including protein, carbohydrate and fat estimates based on your selected goal and activity.',
  'Other': 'Find educational estimates for body surface area, kidney filtration, blood alcohol concentration and body measurements, with limitations explained on each page.',
};
const pageUrl = new URL('/health-calculators/', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': new URL('/', Astro.site).href },
        { '@type': 'ListItem', 'position': 2, 'name': 'Free Health & Fitness Calculators', 'item': pageUrl },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': pageUrl,
      'name': 'Free Health & Fitness Calculators',
      'url': pageUrl,
      'description': 'Health and fitness calculators for energy needs, nutrition, body measurements, heart rate and pregnancy estimates.',
      'mainEntity': {
        '@type': 'ItemList',
        'numberOfItems': healthTools.length,
        'itemListElement': healthTools.map((tool, index) => ({
          '@type': 'ListItem',
          'position': index + 1,
          'name': tool.name,
          'url': new URL(`/health/${tool.slug}/`, Astro.site).href,
        })),
      },
    },
  ],
};
---
<Layout title="Free Health & Fitness Calculators" description="Free health calculators for BMI, calories, body fat, nutrition, heart rate, pregnancy and fitness estimates.">
  <section class="shell py-14 sm:py-20">
    <div class="mb-6 text-sm text-[var(--muted)]"><a href="/">Home</a><span class="mx-2">/</span>Health & fitness calculators</div>
    <p class="eyebrow">27 educational tools</p><h1 class="display mt-4 max-w-3xl text-4xl sm:text-5xl">Free Health & Fitness Calculators</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">Choose the tool that fits your question: estimate maintenance energy with the <a class="font-medium text-[var(--color-primary)]" href="/health/tdee-calculator/">TDEE calculator</a>, set a weight-based intake with the <a class="font-medium text-[var(--color-primary)]" href="/health/protein-calculator/">protein calculator</a>, estimate pregnancy timing with the <a class="font-medium text-[var(--color-primary)]" href="/health/due-date-calculator/">due date calculator</a>, or browse <a class="font-medium text-[var(--color-primary)]" href="/running-calculators/">running calculators</a> for pace and training plans.</p>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-[var(--muted)]">Equations describe estimates, not diagnoses or direct measurements. Check the method and limitations on the calculator page, and seek qualified care for health or pregnancy decisions.</p>
    <label class="panel mt-8 block max-w-xl p-1.5"><span class="sr-only">Search health calculators</span><input class="control border-0 shadow-none" type="search" placeholder="Search BMI, calories, protein..." data-catalog-search /></label>
  </section>
  <section class="shell border-t pb-20 pt-10" style="border-color:var(--line)" data-catalog>
    <div class="catalog-group mb-12"><h2 class="text-lg font-semibold">Running</h2><p class="mb-4 mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">Convert pace and speed, plan race splits and find training ranges in the dedicated running collection.</p><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><a href="/running-calculators/" class="group flex items-center justify-between gap-4 rounded-xl border bg-[var(--panel)] p-4 transition hover:border-[var(--color-primary)]" style="border-color:var(--line)"><div><h3 class="text-sm font-semibold">Running Calculators</h3><p class="mt-1 text-xs text-[var(--muted)]">Pace, race day and training</p></div><span>-&gt;</span></a></div></div>
    {healthGroups.map((group) => <div class="catalog-group mb-12"><h2 class="text-lg font-semibold">{group}</h2><p class="mb-4 mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">{groupDescriptions[group]}</p><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{healthTools.filter((tool) => tool.group === group).map((tool) => <GeneralToolCard tool={tool} />)}</div></div>)}
    <p class="hidden rounded-xl border bg-[var(--panel)] p-6 text-center text-sm text-[var(--muted)]" data-empty>No matching calculator found.</p>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
<script>const input=document.querySelector<HTMLInputElement>('[data-catalog-search]');const empty=document.querySelector<HTMLElement>('[data-empty]');input?.addEventListener('input',()=>{let visible=0;document.querySelectorAll<HTMLElement>('[data-catalog] a').forEach(card=>{const match=card.textContent?.toLowerCase().includes(input.value.trim().toLowerCase())??false;card.classList.toggle('hidden',!match);if(match)visible++});document.querySelectorAll<HTMLElement>('.catalog-group').forEach(group=>group.classList.toggle('hidden',!group.querySelector('a:not(.hidden)')));empty?.classList.toggle('hidden',visible>0)});</script>
