---
import Layout from './Layout.astro';
const { title, description, updated = 'August 16, 2026' } = Astro.props;
---
<Layout title={title} description={description}>
  <section class="shell grid gap-10 py-16 lg:grid-cols-[16rem_1fr] lg:py-20">
    <div><p class="eyebrow">CalcFino Tools</p><h1 class="display mt-4 text-4xl sm:text-5xl">{title}</h1><p class="mt-4 text-sm text-[var(--muted)]">Last updated: {updated}</p></div>
    <article class="prose-copy max-w-3xl"><slot /></article>
  </section>
</Layout>
